.action-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 680rpx;
  min-height: 146rpx;
  margin: 0 auto;
  padding: 22rpx 14rpx 22rpx 18rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 26rpx rgba(24, 54, 80, 0.055);
  margin-bottom: 8rpx;
}

.action-row:active {
  background: #fbfdfb;
}

.action-row__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 90rpx;
  flex: 0 0 90rpx;
}

.action-row__icon {
  width: 82rpx;
  height: 82rpx;
}

.action-row__copy {
  min-width: 0;
  flex: 1;
  margin-left: 16rpx;
}

.action-row__title,
.action-row__description {
  display: block;
}

.action-row__title {
  overflow: hidden;
  color: #15171a;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-row__description {
  margin-top: 12rpx;
  overflow: hidden;
  color: #727782;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-row__end {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 128rpx;
  margin-left: 12rpx;
  flex: 0 0 128rpx;
  transform: translateY(8rpx);
}

.action-row__button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 128rpx;
  min-width: 128rpx;
  height: 54rpx;
  padding: 0;
  flex: 0 0 128rpx;
  border: 2rpx solid #28a366;
  border-radius: 28rpx;
  color: #25995f;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
}

.action-row__button-mark {
  display: block;
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  flex: 0 0 18rpx;
}

.action-row--blue .action-row__button {
  border-color: #2b7ce2;
  color: #2874d1;
}

.action-row--orange .action-row__button {
  border-color: #e99a31;
  color: #dc8516;
}

.action-row--solid .action-row__button {
  border-color: #22aa5d;
  background: #22aa5d;
  color: #ffffff;
}
