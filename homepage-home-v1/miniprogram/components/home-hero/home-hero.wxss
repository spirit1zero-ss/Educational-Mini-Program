.hero {
  position: relative;
  width: 750rpx;
  height: 920rpx;
  overflow: hidden;
  background: #c9efff;
}

.hero__background {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  height: 924.17rpx;
}

.hero__heading {
  position: absolute;
  z-index: 2;
  top: 26rpx;
  left: 42rpx;
}

.hero__eyebrow {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #179653;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 54rpx;
  box-shadow: 0 6rpx 18rpx rgba(52, 133, 97, 0.08);
}

.hero__sprout {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.hero__title {
  margin-top: 28rpx;
  color: #07123f;
  font-size: 67rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 1.08;
  white-space: nowrap;
}

.hero__subtitle {
  margin-top: 18rpx;
  color: #425a69;
  font-size: 33rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.hero__module-list {
  position: absolute;
  z-index: 3;
  top: 306rpx;
  right: 34rpx;
  width: 292rpx;
}

.module-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 292rpx;
  height: 156rpx;
  padding: 22rpx 16rpx 18rpx 24rpx;
  border: 2rpx solid rgba(31, 172, 91, 0.38);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(40, 74, 89, 0.1);
  overflow: hidden;
}

.module-card:active {
  opacity: 0.88;
  transform: scale(0.985);
}

.module-card + .module-card {
  margin-top: 34rpx;
}

.module-card--blue {
  border-color: rgba(43, 121, 231, 0.34);
}

.module-card--orange {
  border-color: rgba(255, 138, 16, 0.38);
}

.module-card__copy {
  min-width: 0;
  flex: 1;
}

.module-card__title-row {
  display: flex;
  align-items: center;
}

.module-card__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  border-radius: 50%;
  background: #21a75a;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1;
}

.module-card--blue .module-card__badge {
  background: #287ce5;
}

.module-card--orange .module-card__badge {
  background: #ff880d;
}

.module-card__title {
  margin-left: 15rpx;
  color: #179653;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.1;
  white-space: nowrap;
}

.module-card--blue .module-card__title,
.module-card--blue .module-card__subtitle {
  color: #2877d5;
}

.module-card--orange .module-card__title,
.module-card--orange .module-card__subtitle {
  color: #e57912;
}

.module-card__subtitle {
  display: block;
  margin-top: 18rpx;
  color: #159653;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.25;
  white-space: nowrap;
}

.module-card__visual {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 58rpx;
  margin-left: 6rpx;
  flex: 0 0 58rpx;
}

.module-card__icon {
  width: 50rpx;
  height: 50rpx;
}

.module-card__click-mark {
  display: block;
  width: 36rpx;
  height: 36rpx;
  margin-top: 8rpx;
}
