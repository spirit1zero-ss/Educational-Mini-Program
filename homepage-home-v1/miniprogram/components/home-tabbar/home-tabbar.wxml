<view class="tabbar" style="padding-bottom: {{safeBottom}}px;">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tabbar__item {{active === item.key ? 'tabbar__item--active' : ''}}"
    role="button"
    aria-label="{{item.label}}"
    data-index="{{index}}"
    bindtap="onTabTap"
  >
    <image
      class="tabbar__icon"
      src="{{active === item.key ? item.activeIcon : item.icon}}"
      mode="aspectFit"
    ></image>
    <text class="tabbar__label">{{item.label}}</text>
  </view>
</view>
