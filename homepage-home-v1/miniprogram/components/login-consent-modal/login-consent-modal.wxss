.consent-layer {
  position: fixed;
  z-index: 9999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.consent-mask {
  position: absolute;
  inset: 0;
  background: rgba(8, 26, 20, 0.48);
  backdrop-filter: blur(5rpx);
}

.consent-dialog {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-height: 84vh;
  padding: 34rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: #f8fbf6;
  box-shadow: 0 -20rpx 70rpx rgba(10, 55, 38, 0.18);
  animation: consent-rise 180ms ease-out;
}

@keyframes consent-rise {
  from { transform: translateY(28rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.dialog-head {
  display: flex;
  align-items: center;
}

.brand-mark {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 auto;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #e6f7e9, #f5fbef);
}

.brand-stem {
  position: absolute;
  bottom: 14rpx;
  left: 34rpx;
  width: 4rpx;
  height: 36rpx;
  border-radius: 99rpx;
  background: #179c5c;
}

.brand-leaf {
  position: absolute;
  width: 25rpx;
  height: 17rpx;
  background: linear-gradient(135deg, #74d666, #15985a);
}

.brand-leaf--left {
  top: 24rpx;
  left: 11rpx;
  border-radius: 20rpx 3rpx 20rpx 3rpx;
  transform: rotate(18deg);
}

.brand-leaf--right {
  top: 13rpx;
  right: 10rpx;
  border-radius: 3rpx 20rpx 3rpx 20rpx;
  transform: rotate(-16deg);
}

.head-copy {
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
}

.dialog-title {
  color: #09234c;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.dialog-subtitle {
  margin-top: 2rpx;
  color: #75827b;
  font-size: 23rpx;
  line-height: 34rpx;
}

.close-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: #eaf2eb;
  color: #648075;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 54rpx;
}

.privacy-note,
.status-card {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(28, 145, 86, 0.16);
  border-radius: 20rpx;
  background: #edf8ef;
  color: #456457;
  font-size: 24rpx;
  line-height: 38rpx;
}

.status-card {
  display: flex;
  align-items: flex-start;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 10rpx 16rpx 0 0;
  flex: 0 0 auto;
  border: 5rpx solid #c5edd2;
  border-radius: 50%;
  background: #159d60;
}

.status-title {
  color: #17633f;
  font-size: 26rpx;
  font-weight: 800;
}

.status-desc {
  margin-top: 3rpx;
  color: #668073;
  font-size: 22rpx;
}

.agreement-list {
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(35, 92, 69, 0.1);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(28, 78, 58, 0.06);
}

.agreement-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
}

.agreement-name {
  color: #214c3a;
  font-size: 27rpx;
  font-weight: 800;
}

.agreement-desc {
  margin-top: 4rpx;
  color: #849088;
  font-size: 21rpx;
}

.agreement-arrow {
  margin-left: 18rpx;
  color: #25a366;
  font-size: 40rpx;
}

.agreement-divider {
  height: 1rpx;
  background: #edf1ed;
}

.consent-row {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 0 4rpx;
}

.check-box {
  position: relative;
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  margin: 2rpx 14rpx 0 0;
  flex: 0 0 auto;
  border: 3rpx solid #a8b5ad;
  border-radius: 10rpx;
  background: #ffffff;
}

.check-box--active {
  border-color: #159d60;
  background: #159d60;
}

.check-mark {
  position: absolute;
  top: 7rpx;
  left: 8rpx;
  width: 14rpx;
  height: 7rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(-45deg);
}

.consent-copy {
  color: #66756d;
  font-size: 22rpx;
  line-height: 36rpx;
}

.consent-link {
  color: #168d55;
  font-weight: 700;
}

.primary-button,
.withdraw-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 26rpx;
  border: 0;
  border-radius: 44rpx;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.primary-button::after,
.withdraw-button::after {
  display: none;
}

.primary-button {
  background: linear-gradient(135deg, #17a463, #0f8d54);
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(20, 151, 89, 0.2);
}

.primary-button--disabled {
  background: #c9d7cd;
  box-shadow: none;
}

.withdraw-button {
  border: 1rpx solid #e4b9b0;
  background: #fff8f6;
  color: #a44c3c;
}

.helper-text {
  margin-top: 18rpx;
  color: #93a098;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}
