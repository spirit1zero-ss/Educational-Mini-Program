.sticky-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  gap: 18rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 30rpx rgba(31, 42, 36, 0.04);
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.primary-button {
  flex: 1;
  background: #1f6b57;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(31, 107, 87, 0.18);
}

.primary-button--disabled {
  background: #dbe4dd;
  color: #89958e;
  box-shadow: none;
}

.secondary-button {
  min-width: 204rpx;
  padding: 0 26rpx;
  background: #eef7ec;
  color: #1f6b57;
}
