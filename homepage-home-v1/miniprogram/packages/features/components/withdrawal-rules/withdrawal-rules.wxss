.withdrawal-rules { margin-top: 24rpx; padding: 26rpx; border: 1rpx solid #dce8df; border-radius: 24rpx; background: #fff; }
.rules-title { color: #173c2f; font-size: 30rpx; font-weight: 800; line-height: 42rpx; }
.rules-row { margin-top: 20rpx; }
.rules-label { color: #245c4a; font-size: 25rpx; font-weight: 700; line-height: 36rpx; }
.rules-description { margin-top: 5rpx; color: #52675b; font-size: 24rpx; line-height: 38rpx; overflow-wrap: break-word; }
.withdrawal-rules--compact { padding: 22rpx; background: #f5faf6; border-radius: 18rpx; }
.withdrawal-rules--compact .rules-title { font-size: 27rpx; }
.withdrawal-rules--compact .rules-description { font-size: 23rpx; line-height: 35rpx; }
.rules-retry { margin: 20rpx 0 0; padding: 12rpx; background: #edf5ef; color: #245c4a; font-size: 23rpx; line-height: 36rpx; white-space: normal; }
.rules-retry::after { border: 0; }
