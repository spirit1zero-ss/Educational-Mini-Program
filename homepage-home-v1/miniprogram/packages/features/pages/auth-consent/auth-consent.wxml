<view class="page">
  <custom-nav
    title="{{mode === 'settings' ? '协议与隐私' : '登录授权'}}"
    showBack="{{true}}"
    showHome="{{mode === 'settings'}}"
  ></custom-nav>

  <view class="hero">
    <view class="hero-glow hero-glow--one"></view>
    <view class="hero-glow hero-glow--two"></view>
    <view class="leaf-mark">
      <view class="leaf leaf--left"></view>
      <view class="leaf-stem"></view>
      <view class="leaf leaf--right"></view>
    </view>
    <view class="hero-kicker">自主学习训练营</view>
    <view class="hero-title">{{mode === 'settings' ? '你的授权，由你管理' : '登录后继续使用完整服务'}}</view>
    <view class="hero-desc">
      {{mode === 'settings' ? '随时查看协议内容和当前授权状态' : '首次使用账号功能前，请阅读并确认以下内容'}}
    </view>
  </view>

  <view class="content">
    <view class="info-card">
      <view class="card-title">我们会如何使用信息</view>
      <view class="info-row">
        <view class="info-number">1</view>
        <view class="info-copy">
          <view class="info-title">用于账号登录</view>
          <view class="info-desc">通过微信临时登录凭证识别你的账号并保持登录状态。</view>
        </view>
      </view>
      <view class="info-row">
        <view class="info-number info-number--blue">2</view>
        <view class="info-copy">
          <view class="info-title">按需提供服务</view>
          <view class="info-desc">订单、会员、报名和邀请等信息只在使用对应功能时处理。</view>
        </view>
      </view>
      <view class="info-row">
        <view class="info-number info-number--orange">3</view>
        <view class="info-copy">
          <view class="info-title">资料单独确认</view>
          <view class="info-desc">此步骤不会获取手机号、头像或孩子资料，相关资料会在需要时另行说明。</view>
        </view>
      </view>
    </view>

    <view class="agreement-card">
      <view class="agreement-title">协议与隐私</view>
      <view class="agreement-item" bindtap="onOpenUserAgreement">
        <view>
          <view class="agreement-name">用户服务协议</view>
          <view class="agreement-desc">账号使用、服务规则和未成年人使用说明</view>
        </view>
        <view class="agreement-arrow">›</view>
      </view>
      <view class="agreement-divider"></view>
      <view class="agreement-item" bindtap="onOpenPrivacyGuide">
        <view>
          <view class="agreement-name">{{privacyContractName}}</view>
          <view class="agreement-desc">了解信息收集、使用和保护方式</view>
        </view>
        <view class="agreement-arrow">›</view>
      </view>
    </view>

    <view class="consent-status" wx:if="{{mode === 'settings' && hasConsent}}">
      <view class="status-dot"></view>
      <view>
        <view class="status-title">当前已同意登录授权</view>
        <view class="status-desc">你可以继续使用会员、订单和报名等账号功能。</view>
      </view>
    </view>

    <view wx:if="{{mode === 'login' || !hasConsent}}" class="consent-row" bindtap="onToggleAgreement">
      <view class="check-box {{agreed ? 'check-box--active' : ''}}">
        <view class="check-mark" wx:if="{{agreed}}"></view>
      </view>
      <view class="consent-copy">
        我已阅读并同意
        <text class="consent-link" catchtap="onOpenUserAgreement">《用户服务协议》</text>
        和
        <text class="consent-link" catchtap="onOpenPrivacyGuide">《用户隐私保护指引》</text>
      </view>
    </view>

    <button
      wx:if="{{(mode === 'login' || !hasConsent) && needPrivacyAuthorization}}"
      class="primary-button {{!agreed ? 'primary-button--disabled' : ''}}"
      disabled="{{!agreed || submitting || privacyChecking}}"
      loading="{{submitting}}"
      open-type="agreePrivacyAuthorization"
      bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
    >
      同意并继续
    </button>
    <button
      wx:elif="{{mode === 'login' || !hasConsent}}"
      class="primary-button {{!agreed ? 'primary-button--disabled' : ''}}"
      disabled="{{!agreed || submitting || privacyChecking}}"
      loading="{{submitting}}"
      bindtap="onAgreeAndContinue"
    >
      同意并继续
    </button>

    <button
      wx:if="{{mode === 'settings' && hasConsent}}"
      class="withdraw-button"
      bindtap="onWithdrawConsent"
    >
      撤回登录授权并退出账号
    </button>

    <view wx:if="{{mode === 'login'}}" class="decline-button" bindtap="onDeclineAndBack">
      暂不同意，返回浏览
    </view>

    <view class="helper-text">
      不同意不会影响首页和本地测评浏览，但无法使用需要账号的会员、订单、支付、邀请及收益功能。
    </view>
    <view class="helper-text helper-text--minor">
      如需提交未成年人资料，请确保你是其监护人或已取得监护人授权。
    </view>
  </view>

  <view class="safe-spacer"></view>
</view>
