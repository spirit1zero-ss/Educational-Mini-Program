page {
  background: #f3f8f2;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 82% 16%, rgba(255, 226, 145, 0.34), transparent 28%),
    linear-gradient(180deg, #f7faf4 0%, #edf7f5 42%, #f6f9f2 100%);
  color: #1f2d27;
}

.hero {
  position: relative;
  box-sizing: border-box;
  min-height: 328rpx;
  padding: 42rpx 42rpx 48rpx;
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(1rpx);
}

.hero-glow--one {
  top: 18rpx;
  right: -84rpx;
  width: 270rpx;
  height: 270rpx;
  background: rgba(111, 196, 128, 0.16);
}

.hero-glow--two {
  bottom: -110rpx;
  left: -64rpx;
  width: 230rpx;
  height: 230rpx;
  background: rgba(92, 166, 226, 0.12);
}

.leaf-mark {
  position: relative;
  width: 92rpx;
  height: 76rpx;
  margin-bottom: 18rpx;
}

.leaf-stem {
  position: absolute;
  bottom: 4rpx;
  left: 43rpx;
  width: 5rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: #16995b;
  transform: rotate(-8deg);
}

.leaf {
  position: absolute;
  width: 42rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #6ed45f 0%, #16995b 100%);
}

.leaf--left {
  top: 14rpx;
  left: 4rpx;
  border-radius: 32rpx 4rpx 32rpx 4rpx;
  transform: rotate(18deg);
}

.leaf--right {
  top: 2rpx;
  right: 0;
  border-radius: 4rpx 32rpx 4rpx 32rpx;
  transform: rotate(-14deg);
}

.hero-kicker {
  color: #15975a;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title {
  max-width: 620rpx;
  margin-top: 12rpx;
  color: #071d4d;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-desc {
  margin-top: 16rpx;
  color: #64756d;
  font-size: 27rpx;
  line-height: 1.6;
}

.content {
  position: relative;
  z-index: 1;
  margin-top: -28rpx;
  padding: 0 28rpx;
}

.info-card,
.agreement-card {
  border: 1rpx solid rgba(41, 99, 75, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 42rpx rgba(36, 92, 74, 0.08);
}

.info-card {
  padding: 30rpx 28rpx 8rpx;
}

.card-title,
.agreement-title {
  color: #071d4d;
  font-size: 31rpx;
  font-weight: 900;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #edf2ed;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 18rpx;
  flex: 0 0 auto;
  border-radius: 16rpx;
  background: #159d60;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(21, 157, 96, 0.16);
}

.info-number--blue {
  background: #2d85ea;
  box-shadow: 0 8rpx 18rpx rgba(45, 133, 234, 0.16);
}

.info-number--orange {
  background: #ff8218;
  box-shadow: 0 8rpx 18rpx rgba(255, 130, 24, 0.16);
}

.info-copy {
  min-width: 0;
  flex: 1;
}

.info-title {
  color: #20302a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.info-desc {
  margin-top: 5rpx;
  color: #6c7a73;
  font-size: 24rpx;
  line-height: 38rpx;
}

.agreement-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.agreement-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 18rpx;
}

.agreement-name {
  color: #226047;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.agreement-desc {
  margin-top: 4rpx;
  color: #7b8780;
  font-size: 22rpx;
  line-height: 34rpx;
}

.agreement-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 20rpx;
  border-radius: 16rpx;
  background: #edf7f0;
  color: #15975a;
  font-size: 38rpx;
  line-height: 44rpx;
}

.agreement-divider {
  height: 1rpx;
  background: #edf2ed;
}

.consent-status {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(21, 157, 96, 0.2);
  border-radius: 22rpx;
  background: rgba(235, 249, 239, 0.92);
}

.status-dot {
  width: 18rpx;
  height: 18rpx;
  margin: 10rpx 18rpx 0 2rpx;
  flex: 0 0 auto;
  border: 6rpx solid #c9f1d5;
  border-radius: 50%;
  background: #159d60;
}

.status-title {
  color: #17633f;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.status-desc {
  margin-top: 4rpx;
  color: #5f796a;
  font-size: 22rpx;
  line-height: 34rpx;
}

.consent-row {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  padding: 0 6rpx;
}

.check-box {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  margin: 2rpx 14rpx 0 0;
  flex: 0 0 auto;
  border: 3rpx solid #a8b5ad;
  border-radius: 11rpx;
  background: #ffffff;
}

.check-box--active {
  border-color: #159d60;
  background: #159d60;
}

.check-mark {
  position: absolute;
  top: 7rpx;
  left: 9rpx;
  width: 15rpx;
  height: 8rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(-45deg);
}

.consent-copy {
  color: #6d7a73;
  font-size: 23rpx;
  line-height: 40rpx;
}

.consent-link {
  color: #148c56;
  font-weight: 700;
}

button::after {
  border: 0;
}

.primary-button,
.withdraw-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  margin-top: 26rpx;
  border: 0;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.primary-button {
  background: linear-gradient(135deg, #159d60 0%, #087a4c 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(8, 122, 76, 0.22);
}

.primary-button--disabled {
  background: #dfe7df;
  color: #95a198;
  box-shadow: none;
}

.withdraw-button {
  border: 1rpx solid rgba(177, 79, 63, 0.2);
  background: #fff8f5;
  color: #a14a3c;
  box-shadow: none;
}

.decline-button {
  margin-top: 20rpx;
  padding: 14rpx 0;
  color: #738078;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: center;
}

.helper-text {
  margin-top: 22rpx;
  padding: 0 14rpx;
  color: #7d8982;
  font-size: 21rpx;
  line-height: 34rpx;
  text-align: center;
}

.helper-text--minor {
  margin-top: 8rpx;
  color: #8f7e5c;
}

.safe-spacer {
  height: calc(38rpx + env(safe-area-inset-bottom));
}
