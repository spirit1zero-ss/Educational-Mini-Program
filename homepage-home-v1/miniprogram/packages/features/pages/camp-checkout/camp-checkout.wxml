<view class="page">
  <custom-nav title="报名支付" showBack="{{true}}" showHome="{{true}}"></custom-nav>

  <scroll-view class="checkout-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view class="order-hero">
        <view class="hero-tag">报名确认</view>
        <view class="hero-title">{{product.title}}</view>
        <view class="hero-desc">{{product.subtitle}}</view>
        <view class="hero-price">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{product.price}}</text>
          <text class="price-origin" wx:if="{{showOriginPrice}}">原价 ¥{{product.originPrice}}</text>
        </view>
        <view class="price-load-error" wx:if="{{planLoadError}}" bindtap="loadMemberPlan">价格加载失败，点击重试</view>
      </view>

      <view class="info-card">
        <view class="card-title">报名后获得</view>
        <view class="benefit-grid">
          <view class="benefit-item" wx:for="{{benefits}}" wx:key="title">
            <view class="benefit-icon-wrap">
              <image class="benefit-icon" src="{{item.icon}}" mode="aspectFit"></image>
            </view>
            <view class="benefit-title">{{item.title}}</view>
            <view class="benefit-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>

      <view class="info-card">
        <view class="card-title">订单明细</view>
        <view class="detail-row">
          <view class="detail-label">训练营</view>
          <view class="detail-value">{{product.title}}</view>
        </view>
        <view class="detail-row">
          <view class="detail-label">服务内容</view>
          <view class="detail-value">直播课 + 打卡陪跑 + 答疑服务</view>
        </view>
        <view class="detail-row">
          <view class="detail-label">支付方式</view>
          <view class="detail-value payment-value">微信支付</view>
        </view>
        <view class="detail-row detail-row--total">
          <view class="detail-label">实付金额</view>
          <view class="total-price">¥{{product.price}}</view>
        </view>
      </view>

      <view class="notice-card">
        <view class="notice-title">支付后说明</view>
        <view class="notice-line" wx:for="{{notices}}" wx:key="*this">{{item}}</view>
        <button class="contact-button" open-type="contact" show-message-card>联系客服</button>
      </view>

      <view class="agreement-row">
        <view class="check-dot {{agreed ? 'check-dot--active' : ''}}" bindtap="onToggleAgreement"></view>
        <view class="agreement-copy">
          <text bindtap="onToggleAgreement">我已确认课程内容、价格与入班流程，并阅读同意</text>
          <text class="agreement-link" catchtap="onOpenAgreement" data-key="service">《训练营服务协议》</text>
          <text>和</text>
          <text class="agreement-link" catchtap="onOpenAgreement" data-key="privacy">《隐私政策》</text>
        </view>
      </view>

      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <view
    class="profile-mask"
    wx:if="{{profileVisible}}"
    bindtap="closeProfileModal"
    catchtouchmove="preventProfileMaskMove"
  >
    <view class="profile-dialog" catchtap="preventProfileMaskMove">
      <view class="profile-dialog-head">
        <view>
          <view class="profile-kicker">支付前确认</view>
          <view class="profile-title">注册成为会员</view>
        </view>
        <view class="profile-close" bindtap="closeProfileModal">×</view>
      </view>

      <button
        class="profile-avatar-button"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >
        <view class="profile-avatar-frame">
          <image
            wx:if="{{profile.avatarUrl}}"
            class="profile-avatar"
            src="{{profile.avatarUrl}}"
            mode="aspectFill"
          ></image>
          <view wx:else class="profile-avatar-placeholder">＋</view>
        </view>
        <view class="profile-avatar-tip">点击上传头像</view>
      </button>

      <view class="profile-field">
        <view class="profile-field-label">昵称</view>
        <input
          class="profile-input"
          type="nickname"
          maxlength="20"
          value="{{profile.nickname}}"
          placeholder="请选择微信昵称或输入称呼"
          data-field="nickname"
          bindinput="onProfileInput"
        />
      </view>

      <view class="profile-field">
        <view class="profile-field-label">手机号</view>
        <input
          class="profile-input"
          type="number"
          maxlength="11"
          value="{{profile.phone}}"
          placeholder="请输入11位手机号"
          data-field="phone"
          bindinput="onProfileInput"
        />
      </view>

      <view class="profile-helper">请填写真实手机号，方便助教老师联系。</view>
      <button
        class="profile-submit"
        loading="{{profileSubmitting}}"
        disabled="{{profileSubmitting}}"
        bindtap="submitProfileAndPay"
      >
        确认资料并支付
      </button>
    </view>
  </view>

  <view class="pay-bar">
    <view class="pay-summary">
      <view class="pay-label">合计</view>
      <view class="pay-price">¥{{product.price}}</view>
    </view>
    <button
      class="pay-button {{(!agreed || submitting || planLoading) ? 'pay-button--disabled' : ''}}"
      disabled="{{!agreed || submitting || planLoading}}"
      loading="{{submitting || planLoading}}"
      bindtap="onPayTap"
    >
      {{planLoading ? '价格加载中' : (planLoadError ? '重新加载价格' : '确认支付 ¥' + product.price)}}
    </button>
  </view>
</view>
