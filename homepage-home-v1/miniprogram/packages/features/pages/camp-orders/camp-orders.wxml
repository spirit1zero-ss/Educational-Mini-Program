<view class="page">
  <view class="custom-nav" style="{{navStyle}}">
    <view class="back-button" bindtap="onBackTap">‹</view>
    <view class="nav-title">训练营订单</view>
  </view>

  <scroll-view class="records-scroll" style="{{scrollStyle}}" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view class="summary-card">
        <view class="summary-head">
          <view>
            <view class="summary-kicker">训练营订单</view>
            <view class="summary-title">21天自主学习训练营</view>
            <view class="summary-desc">报名、支付与订单状态记录</view>
          </view>
          <image class="summary-icon" src="/assets/mine/icon-camp-order.svg" mode="aspectFit"></image>
        </view>

        <view class="summary-stats">
          <view class="summary-stat" wx:for="{{summary}}" wx:key="key">
            <view class="summary-value">{{item.value}}</view>
            <view class="summary-label">{{item.label}}</view>
          </view>
        </view>

        <view class="poster-entry" bindtap="onCampTap">查看训练营详情</view>
      </view>

      <view class="status-tabs">
        <view
          class="status-tab {{activeStatus === item.key ? 'status-tab--active' : ''}}"
          wx:for="{{statusTabs}}"
          wx:key="key"
          bindtap="onStatusTap"
          data-key="{{item.key}}"
        >
          <view class="status-text">{{item.text}}</view>
          <view class="status-count">{{item.count}}</view>
        </view>
      </view>

      <view class="records-panel" wx:if="{{filteredOrders.length}}">
        <view class="order-card" wx:for="{{filteredOrders}}" wx:key="id">
          <view class="order-head">
            <view class="order-title">{{item.title}}</view>
            <view class="status-badge status-badge--{{item.status}}">{{item.statusText}}</view>
          </view>
          <view class="order-info">
            <view class="order-line">报名人：{{item.buyer}} · {{item.phone}}</view>
            <view class="order-line">订单号：{{item.orderNo}}</view>
            <view class="order-line">下单时间：{{item.time}}</view>
          </view>
          <view class="order-foot">
            <view class="order-amount">实付 {{item.amount}}</view>
            <view class="order-actions" wx:if="{{item.status === 'pending'}}">
              <view
                class="order-action order-action--ghost"
                bindtap="onCancelTap"
                data-order-no="{{item.orderNo}}"
              >取消订单</view>
              <view
                class="order-action"
                bindtap="onPayTap"
                data-order-no="{{item.orderNo}}"
              >继续支付</view>
            </view>
            <view
              class="order-action"
              wx:elif="{{item.status === 'paid'}}"
              bindtap="onRegistrationTap"
            >去填写登记表</view>
            <view class="order-action order-action--disabled" wx:else>已关闭</view>
          </view>
        </view>
      </view>

      <view class="empty-panel" wx:else>
        <image class="empty-icon" src="/assets/mine/icon-camp-order.svg" mode="aspectFit"></image>
        <view class="empty-title">{{isAuthed ? '暂无对应训练营订单' : '暂无订单'}}</view>
        <view class="empty-desc">报名训练营后，订单会在这里展示</view>
        <view class="empty-button" bindtap="onCampTap">查看训练营</view>
      </view>
    </view>
  </scroll-view>
</view>
