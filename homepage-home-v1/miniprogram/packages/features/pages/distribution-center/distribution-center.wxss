.page {
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #eef5ee 0%, #f7f9f5 44%, #ffffff 100%);
  color: #1c2d25;
}

.custom-nav {
  position: relative;
  box-sizing: border-box;
  min-height: 88px;
  padding: 44px 110px 18rpx 32rpx;
  background: rgba(238, 245, 238, 0.96);
}

.back-button {
  position: absolute;
  left: 24rpx;
  bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  color: #245c4a;
  font-size: 58rpx;
  line-height: 58rpx;
}

.nav-title {
  color: #183327;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
  white-space: nowrap;
}

.center-scroll {
  height: calc(100vh - 88px);
}

.content {
  padding: 8rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.identity-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 30rpx;
  background: linear-gradient(145deg, #173f32 0%, #245c4a 58%, #2f6b43 100%);
  box-shadow: 0 18rpx 38rpx rgba(28, 77, 58, 0.2);
  color: #ffffff;
}

.identity-orbit {
  position: absolute;
  right: -86rpx;
  top: -126rpx;
  width: 330rpx;
  height: 330rpx;
  border: 1rpx solid rgba(255, 244, 203, 0.18);
  border-radius: 50%;
  box-shadow: inset 0 0 0 54rpx rgba(255, 255, 255, 0.025);
}

.identity-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.identity-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(255, 244, 203, 0.32);
  border-radius: 22rpx;
  background: rgba(255, 248, 218, 0.13);
  color: #fff1bd;
  font-size: 38rpx;
  font-weight: 900;
}

.identity-copy {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.identity-name {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.identity-code {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 21rpx;
  line-height: 28rpx;
}

.identity-status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
  font-weight: 700;
}

.identity-status--active {
  background: rgba(223, 244, 212, 0.13);
  color: #e4f7d7;
}

.available-block {
  position: relative;
  z-index: 1;
  margin-top: 42rpx;
}

.available-label {
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
}

.available-value {
  margin-top: 4rpx;
  font-size: 68rpx;
  font-weight: 900;
  line-height: 82rpx;
  letter-spacing: -2rpx;
}

.available-value text {
  margin-right: 8rpx;
  color: #ffebb0;
  font-size: 30rpx;
  vertical-align: 12rpx;
}

.available-note {
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
  line-height: 30rpx;
}

.identity-summary {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.identity-summary-item {
  padding: 0 12rpx;
  border-right: 1rpx solid rgba(255, 255, 255, 0.1);
}

.identity-summary-item:first-child {
  padding-left: 0;
}

.identity-summary-item:last-child {
  border-right: 0;
}

.identity-summary-value {
  font-size: 27rpx;
  font-weight: 800;
}

.identity-summary-label {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.56);
  font-size: 20rpx;
}

.identity-summary-item--danger .identity-summary-value {
  color: #ffd4c9;
}

.debt-alert {
  display: flex;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(192, 78, 63, 0.16);
  border-radius: 24rpx;
  background: #fff5f2;
}

.debt-alert-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #bc5547;
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
}

.debt-alert-copy {
  margin-left: 16rpx;
}

.debt-alert-title {
  color: #963e33;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.debt-alert-desc {
  margin-top: 6rpx;
  color: #99685f;
  font-size: 21rpx;
  line-height: 32rpx;
}

.section-card,
.money-grid {
  margin-top: 20rpx;
  border: 1rpx solid rgba(47, 107, 67, 0.08);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 26rpx rgba(34, 79, 60, 0.05);
}

.section-card {
  padding: 26rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.section-title {
  color: #1d3329;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.section-desc {
  margin-top: 6rpx;
  color: #78877f;
  font-size: 21rpx;
  line-height: 31rpx;
}

.quota-remaining {
  min-width: 78rpx;
  color: #245c4a;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 50rpx;
  text-align: right;
}

.quota-track {
  height: 12rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8efe9;
}

.quota-progress {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2d6b50, #c49b45);
}

.quota-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #78877f;
  font-size: 21rpx;
}

.money-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  overflow: hidden;
}

.money-cell {
  padding: 24rpx;
  border-right: 1rpx solid #edf1ed;
  border-bottom: 1rpx solid #edf1ed;
}

.money-cell:nth-child(2n) {
  border-right: 0;
}

.money-cell:nth-last-child(-n + 2) {
  border-bottom: 0;
}

.money-label {
  color: #77857d;
  font-size: 21rpx;
}

.money-value {
  margin-top: 8rpx;
  color: #245c4a;
  font-size: 32rpx;
  font-weight: 900;
}

.money-value text {
  margin-left: 4rpx;
  font-size: 20rpx;
}

.money-cell--refund .money-value {
  color: #aa4d41;
}

.action-list {
  margin-top: 10rpx;
}

.action-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid #edf1ed;
}

.action-row:last-child {
  border-bottom: 0;
}

.action-row:active,
.ledger-row:active,
.section-link:active {
  opacity: 0.72;
}

.action-icon {
  width: 42rpx;
  height: 42rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: #f0f6ef;
}

.action-copy {
  flex: 1;
  margin-left: 16rpx;
}

.action-title {
  color: #21352b;
  font-size: 25rpx;
  font-weight: 800;
}

.action-desc {
  margin-top: 4rpx;
  color: #87948d;
  font-size: 20rpx;
}

.action-arrow {
  color: #9aa69f;
  font-size: 42rpx;
}

.section-link {
  padding: 8rpx 0 8rpx 20rpx;
  color: #2f6b43;
  font-size: 22rpx;
  font-weight: 700;
}

.ledger-list {
  margin-top: 12rpx;
}

.ledger-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1ed;
}

.ledger-row:last-child {
  border-bottom: 0;
}

.ledger-mark {
  flex: 0 0 10rpx;
  height: 10rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #3d8160;
}

.ledger-mark--danger {
  background: #bc5547;
}

.ledger-mark--muted {
  background: #a5aea9;
}

.ledger-copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.ledger-title {
  color: #25372e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.ledger-desc {
  margin-top: 5rpx;
  overflow: hidden;
  color: #7c8a82;
  font-size: 20rpx;
  line-height: 29rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-time {
  margin-top: 4rpx;
  color: #a0aaa4;
  font-size: 18rpx;
}

.ledger-amount {
  margin-left: 12rpx;
  color: #2d7354;
  font-size: 26rpx;
  font-weight: 900;
}

.ledger-amount--danger {
  color: #b64f43;
}

.ledger-amount--muted {
  color: #8f9993;
  text-decoration: line-through;
}

.empty-ledger {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 42rpx 0 24rpx;
  color: #95a099;
  font-size: 22rpx;
}

.empty-ledger image {
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 12rpx;
  opacity: 0.55;
}
