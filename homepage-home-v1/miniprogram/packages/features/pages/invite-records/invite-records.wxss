.page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #f8faf4 0%, #eef5eb 46%, #ffffff 100%);
  overflow: hidden;
}

.custom-nav {
  position: relative;
  min-height: 88px;
  padding: 44px 110px 18rpx 32rpx;
  background: rgba(248, 250, 244, 0.94);
}

.back-button {
  position: absolute;
  left: 24rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  color: #245c4a;
  font-size: 54rpx;
  line-height: 54rpx;
}

.nav-title {
  color: #1f2a24;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
  white-space: nowrap;
}

.records-scroll {
  height: calc(100vh - 88px);
}

.content {
  padding: 8rpx 28rpx 44rpx;
}

.summary-card,
.status-tabs,
.records-panel,
.empty-panel {
  border: 1rpx solid rgba(47, 107, 67, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 24rpx rgba(47, 107, 67, 0.045);
}

.summary-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx 26rpx 24rpx;
}

.summary-card::after {
  position: absolute;
  right: -70rpx;
  top: -90rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: rgba(47, 107, 67, 0.08);
  content: "";
}

.summary-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-kicker {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(201, 154, 67, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.9);
  color: #9a6f22;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.summary-title {
  margin-top: 18rpx;
  color: #183327;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.summary-desc {
  margin-top: 8rpx;
  color: #647168;
  font-size: 23rpx;
  line-height: 32rpx;
}

.summary-icon {
  position: relative;
  z-index: 1;
  width: 74rpx;
  height: 74rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: rgba(47, 107, 67, 0.08);
}

.summary-stats {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 30rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(47, 107, 67, 0.08);
  border-bottom: 1rpx solid rgba(47, 107, 67, 0.08);
}

.summary-stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid rgba(47, 107, 67, 0.08);
}

.summary-stat:last-child {
  border-right: 0;
}

.summary-stats--team {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 0;
}

.summary-stats--team .summary-stat {
  padding: 20rpx 8rpx;
  border-right: 1rpx solid rgba(47, 107, 67, 0.08);
  border-bottom: 1rpx solid rgba(47, 107, 67, 0.08);
}

.summary-stats--team .summary-stat:nth-child(3n) {
  border-right: 0;
}

.summary-stats--team .summary-stat:nth-last-child(-n + 3) {
  border-bottom: 0;
}

.summary-value {
  color: #245c4a;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.summary-label {
  margin-top: 4rpx;
  color: #748076;
  font-size: 21rpx;
  line-height: 28rpx;
}

.poster-entry {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #245c4a 0%, #2f6b43 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 72rpx;
  box-shadow: 0 12rpx 24rpx rgba(36, 92, 74, 0.16);
}

.status-tabs {
  display: flex;
  gap: 10rpx;
  margin-top: 22rpx;
  padding: 12rpx;
}

.status-tab {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 18rpx;
  color: #6e7a72;
}

.status-tab--active {
  background: #edf5ea;
  color: #245c4a;
}

.status-text {
  font-size: 23rpx;
  font-weight: 800;
  line-height: 30rpx;
}

.status-count {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 26rpx;
}

.records-panel {
  margin-top: 22rpx;
  overflow: hidden;
}

.record-row {
  display: flex;
  align-items: center;
  min-height: 150rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(47, 107, 67, 0.08);
}

.record-row:last-child {
  border-bottom: 0;
}

.record-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #edf5ea;
  color: #245c4a;
  font-size: 28rpx;
  font-weight: 900;
  overflow: hidden;
}

.record-avatar-image {
  width: 100%;
  height: 100%;
}

.record-main {
  min-width: 0;
  flex: 1;
}

.record-top {
  display: flex;
  align-items: center;
}

.record-name {
  min-width: 0;
  max-width: 230rpx;
  overflow: hidden;
  color: #1f2a24;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  height: 34rpx;
  margin-left: 10rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.status-badge--registered {
  background: rgba(47, 107, 67, 0.1);
  color: #245c4a;
}

.status-badge--pending {
  background: rgba(201, 154, 67, 0.14);
  color: #9a6f22;
}

.status-badge--settled {
  background: rgba(88, 125, 103, 0.12);
  color: #496b59;
}

.record-phone {
  margin-top: 8rpx;
  color: #546158;
  font-size: 23rpx;
  line-height: 30rpx;
}

.record-meta {
  margin-top: 4rpx;
  color: #8a948c;
  font-size: 20rpx;
  line-height: 28rpx;
}

.reward-box {
  flex: 0 0 126rpx;
  text-align: right;
}

.reward-value {
  color: #9a6f22;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.reward-state {
  margin-top: 6rpx;
  color: #8a948c;
  font-size: 20rpx;
  line-height: 28rpx;
}

.empty-panel {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-top: 22rpx;
  padding: 68rpx 36rpx;
  text-align: center;
}

.empty-icon {
  width: 86rpx;
  height: 86rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: #edf5ea;
}

.empty-title {
  margin-top: 22rpx;
  color: #1f2a24;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.empty-desc {
  margin-top: 8rpx;
  color: #748076;
  font-size: 23rpx;
  line-height: 34rpx;
}

.empty-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 210rpx;
  height: 66rpx;
  margin-top: 24rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #245c4a;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 66rpx;
}

.poster-entry:active,
.empty-button:active,
.status-tab:active,
.record-row:active {
  transform: scale(0.99);
}
