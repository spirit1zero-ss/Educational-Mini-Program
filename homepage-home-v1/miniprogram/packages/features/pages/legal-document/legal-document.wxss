.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8faf4 0%, #eef5eb 100%);
}

.document-scroll {
  height: calc(100vh - 88px);
}

.document-card {
  margin: 20rpx 26rpx;
  padding: 32rpx 28rpx 40rpx;
  border: 1rpx solid rgba(36, 92, 74, 0.1);
  border-radius: 24rpx;
  background: #ffffff;
  color: #28342e;
  font-size: 27rpx;
  line-height: 1.8;
  box-shadow: 0 12rpx 30rpx rgba(36, 92, 74, 0.06);
}

.loading {
  padding: 100rpx 0;
  color: #859087;
  text-align: center;
}

.document-content {
  word-break: break-word;
}

.safe-spacer {
  height: calc(30rpx + env(safe-area-inset-bottom));
}
