.page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #f8faf4 0%, #eef5eb 48%, #ffffff 100%);
  overflow: hidden;
}

.page-scroll {
  height: calc(100vh - 100px);
}

.content {
  padding: 8rpx 28rpx 44rpx;
}

.summary-card,
.section-card {
  border: 1rpx solid rgba(47, 107, 67, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 24rpx rgba(47, 107, 67, 0.045);
}

.summary-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx 26rpx 24rpx;
}

.summary-card::after {
  position: absolute;
  right: -70rpx;
  top: -90rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: rgba(201, 154, 67, 0.12);
  content: "";
}

.summary-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.summary-kicker {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(201, 154, 67, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.9);
  color: #9a6f22;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.summary-title {
  margin-top: 18rpx;
  color: #183327;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.summary-desc {
  margin-top: 8rpx;
  color: #647168;
  font-size: 23rpx;
  line-height: 34rpx;
}

.summary-icon {
  position: relative;
  z-index: 1;
  width: 76rpx;
  height: 76rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: rgba(201, 154, 67, 0.12);
  flex: 0 0 auto;
}

.summary-actions {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.ghost-button,
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 70rpx;
  flex: 1;
}

.ghost-button {
  border: 1rpx solid rgba(36, 92, 74, 0.22);
  color: #245c4a;
  background: #ffffff;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, #245c4a 0%, #2f6b43 100%);
  box-shadow: 0 12rpx 24rpx rgba(36, 92, 74, 0.16);
}

.section-card {
  margin-top: 22rpx;
  padding: 26rpx 24rpx;
}

.section-title {
  color: #1f2a24;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.benefit-row {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(47, 107, 67, 0.08);
  border-radius: 18rpx;
  background: linear-gradient(90deg, #f5faf3 0%, #ffffff 100%);
}

.benefit-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  background: #eef7ec;
  flex: 0 0 auto;
}

.benefit-icon {
  width: 48rpx;
  height: 48rpx;
}

.benefit-copy {
  min-width: 0;
  flex: 1;
}

.benefit-title {
  color: #105035;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.benefit-desc {
  margin-top: 5rpx;
  color: #647168;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.note-card {
  border-color: rgba(201, 154, 67, 0.16);
  background: linear-gradient(135deg, #fffaf0 0%, #ffffff 100%);
}

.note-line {
  position: relative;
  margin-top: 16rpx;
  padding-left: 22rpx;
  color: #5f6c64;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.note-line::before {
  position: absolute;
  top: 13rpx;
  left: 2rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d6a84a;
  content: "";
}

.ghost-button:active,
.primary-button:active,
.benefit-row:active {
  transform: scale(0.99);
}
