.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8faf4 0%, #f3f7ef 58%, #ffffff 100%);
  overflow: hidden;
}

.form-scroll {
  height: calc(100vh - 100px - 132rpx - env(safe-area-inset-bottom));
}

.content {
  padding: 0 30rpx 44rpx;
}

.hero,
.form-card,
.tips-card,
.access-card {
  border: 1rpx solid rgba(47, 107, 67, 0.08);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 36, 0.045);
}

.access-card {
  margin-top: 18rpx;
  padding: 34rpx 28rpx;
  text-align: center;
}

.access-title {
  color: #173528;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.access-desc {
  margin-top: 14rpx;
  color: #66746b;
  font-size: 24rpx;
  line-height: 36rpx;
}

.access-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin: 28rpx 0 0;
  border-radius: 999rpx;
  background: #245c4a;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 80rpx;
}

.hero {
  padding: 30rpx 28rpx;
  background:
    radial-gradient(circle at 92% 0%, rgba(214, 168, 74, 0.13), transparent 36%),
    linear-gradient(135deg, #ffffff 0%, #f2faf1 100%);
}

.hero-title {
  color: #173528;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.hero-desc {
  margin-top: 10rpx;
  color: #66746b;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  height: 46rpx;
  margin-top: 22rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff5de;
  color: #9a6f22;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 46rpx;
}

.status-chip--done {
  background: #eef7ec;
  color: #245c4a;
}

.form-card {
  margin-top: 18rpx;
  padding: 8rpx 24rpx 24rpx;
}

.field {
  padding-top: 26rpx;
}

.field-label {
  color: #1e2b25;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.text-input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  border: 1rpx solid rgba(31, 42, 36, 0.1);
  border-radius: 18rpx;
  background: #fbfdf9;
  color: #1f2a24;
  font-size: 27rpx;
  font-weight: 700;
}

.text-input {
  height: 88rpx;
  padding: 0 22rpx;
  line-height: 88rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 22rpx;
  line-height: 38rpx;
}

.placeholder {
  color: #a3aea6;
  font-weight: 500;
}

.choice-row,
.problem-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 14rpx;
}

.choice-pill,
.problem-item {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(31, 42, 36, 0.1);
  border-radius: 999rpx;
  background: #fbfdf9;
  color: #4f5d54;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.problem-item {
  border-radius: 18rpx;
}

.choice-pill--active,
.problem-item--active {
  border-color: rgba(36, 92, 74, 0.32);
  background: #eef7ec;
  color: #245c4a;
}

.native-control {
  width: 0;
  height: 0;
  opacity: 0;
  pointer-events: none;
}

.counter {
  margin-top: 8rpx;
  color: #9aa59d;
  font-size: 21rpx;
  line-height: 28rpx;
  text-align: right;
}

.tips-card {
  margin-top: 18rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #fffaf0 0%, #ffffff 100%);
  border-color: rgba(214, 168, 74, 0.18);
}

.tips-title {
  color: #1d2b26;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.tips-line {
  position: relative;
  margin-top: 12rpx;
  padding-left: 22rpx;
  color: #5f6c64;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.tips-line::before {
  position: absolute;
  top: 13rpx;
  left: 2rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d6a84a;
  content: "";
}

.bottom-spacer {
  height: 36rpx;
}

.submit-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
  background: rgba(255, 255, 255, 0.96);
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #245c4a;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 92rpx;
  box-shadow: 0 12rpx 24rpx rgba(36, 92, 74, 0.18);
}

.submit-button--disabled {
  background: #9ca8a1;
  box-shadow: none;
}
