.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  background: #eaf7ff;
}

.page-scroll {
  flex: 1;
  height: 0;
}

.logic-long {
  min-height: 100%;
  background: #eaf7ff;
}

.poster {
  position: relative;
  box-sizing: border-box;
  padding: 34rpx 30rpx 0;
  overflow: hidden;
  background: #eef9ff;
}

.poster--one {
  padding-top: 0;
}

.poster--two,
.poster--three {
  padding-top: 42rpx;
}

.hero-poster {
  position: relative;
  min-height: 700rpx;
  margin: 0 -30rpx;
  overflow: hidden;
  background: #eef9ff;
}

.hero-landscape {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 390rpx;
}

.hero-copy {
  position: absolute;
  top: 54rpx;
  right: 34rpx;
  z-index: 2;
  width: 356rpx;
}

.hero-title {
  color: #07184f;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.17;
  letter-spacing: 1rpx;
}

.hero-quote {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  margin-top: 34rpx;
  padding: 0 30rpx;
}

.hero-quote-text {
  color: #122551;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.quote-mark {
  position: absolute;
  top: -20rpx;
  left: 0;
  color: #0f7e4c;
  font-size: 66rpx;
  font-weight: 900;
  line-height: 1;
}

.quote-mark--end {
  top: auto;
  right: 0;
  bottom: -34rpx;
  left: auto;
}

.hero-definition {
  position: absolute;
  right: 38rpx;
  bottom: 24rpx;
  left: 38rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  width: auto;
  min-height: 112rpx;
  margin: 0;
  padding: 18rpx 24rpx;
  border: 1rpx solid rgba(21, 148, 83, 0.16);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 24rpx rgba(35, 83, 107, 0.09);
}

.hero-definition-icon {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 auto;
}

.hero-definition-copy {
  color: #294254;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 42rpx;
}

.hero-highlight {
  display: block;
  color: #0f7e4c;
  font-weight: 900;
}

.hero-tree {
  position: absolute;
  bottom: 104rpx;
  left: -22rpx;
  z-index: 1;
  width: 390rpx;
  height: 560rpx;
}

.poster-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 38rpx 34rpx;
  border: 1rpx solid rgba(28, 112, 75, 0.16);
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(38, 88, 114, 0.08);
}

.english-card {
  margin-top: 0;
  padding-top: 24rpx;
  border-radius: 58rpx 58rpx 30rpx 30rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.section-index {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 70rpx;
  height: 70rpx;
  padding: 0 10rpx;
  border-radius: 20rpx 20rpx 20rpx 7rpx;
  background: #159453;
  box-shadow: 0 7rpx 14rpx rgba(20, 132, 79, 0.17);
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 900;
  line-height: 70rpx;
  flex: 0 0 auto;
}

.section-title {
  min-width: 0;
  color: #07184f;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 54rpx;
}

.english-art {
  display: block;
  width: 370rpx;
  height: 286rpx;
  margin: 0 auto -6rpx;
}

.section-heading--english {
  justify-content: center;
  margin-top: 0;
}

.reading-block {
  margin-top: 32rpx;
  padding: 0 10rpx;
}

.reading-row {
  position: relative;
  padding: 22rpx 8rpx 22rpx 38rpx;
  border-bottom: 1rpx dashed #d9e4e0;
}

.reading-row:last-child {
  border-bottom: 0;
}

.reading-dot {
  position: absolute;
  top: 39rpx;
  left: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #159453;
}

.paragraph {
  margin-top: 20rpx;
  color: #30485d;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 49rpx;
}

.reading-row .paragraph {
  margin-top: 0;
}

.paragraph:first-child,
.paragraph--lead {
  margin-top: 28rpx;
}

.logic-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 28rpx;
}

.logic-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  min-height: 116rpx;
  padding: 18rpx 126rpx 18rpx 20rpx;
  border: 1rpx solid rgba(21, 148, 83, 0.2);
  border-radius: 20rpx;
  background: #f6faf4;
}

.logic-row--english-1 {
  border-color: rgba(40, 126, 219, 0.24);
  background: #f1f7ff;
}

.number-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #159453;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 64rpx;
  flex: 0 0 auto;
}

.logic-row--english-1 .number-badge {
  background: #2b7fdb;
}

.logic-text {
  min-width: 0;
  color: #243b4f;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 46rpx;
  flex: 1;
}

.logic-art {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 100rpx;
  height: 92rpx;
}

.takeaway {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 28rpx;
  padding: 28rpx 28rpx;
  border: 1rpx solid rgba(225, 164, 47, 0.36);
  border-radius: 22rpx;
  background: #fffdf7;
}

.takeaway-icon {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 auto;
}

.takeaway-text {
  min-width: 0;
  color: #a96708;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 47rpx;
  flex: 1;
}

.takeaway--stacked .takeaway-text {
  color: #31485a;
}

.takeaway--stacked .takeaway-text view + view {
  margin-top: 8rpx;
}

.screen-divider {
  display: block;
  width: calc(100% + 60rpx);
  height: 210rpx;
  margin: 34rpx -30rpx 0;
  object-position: center bottom;
}

.poster--two .poster-card:first-child {
  margin-top: 0;
}

.math-art {
  display: block;
  width: 360rpx;
  height: 330rpx;
  margin: 22rpx auto 4rpx;
}

.stage-card {
  margin-top: 30rpx;
}

.stage-poster-art {
  display: block;
  width: 450rpx;
  height: 420rpx;
  margin: 24rpx auto 8rpx;
}

.stage-list {
  margin-top: 16rpx;
}

.stage-row {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}

.stage-row + .stage-row {
  margin-top: 18rpx;
}

.stage-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 66rpx;
  flex: 0 0 66rpx;
}

.stage-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #159453;
  box-shadow: 0 6rpx 12rpx rgba(20, 132, 79, 0.16);
}

.stage-icon {
  width: 42rpx;
  height: 42rpx;
  filter: brightness(0) invert(1);
}

.stage-line-rail {
  width: 2rpx;
  min-height: 28rpx;
  margin-top: 6rpx;
  background: #a7d5bd;
  flex: 1;
}

.stage-copy {
  min-width: 0;
  padding: 5rpx 0 20rpx;
  flex: 1;
}

.stage-title {
  color: #0d7c4b;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.stage-line {
  margin-top: 8rpx;
  color: #405568;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 43rpx;
}

.poster--three {
  padding-top: 42rpx;
  background: #eef9ff;
}

.poster--three .poster-card:first-child {
  margin-top: 0;
}

.closing-card {
  border-color: rgba(227, 166, 57, 0.28);
  background: #fffdf7;
}

.closing-quote {
  margin-top: 30rpx;
  color: #07184f;
  font-size: 39rpx;
  font-weight: 900;
  line-height: 1.55;
}

.closing-art {
  display: block;
  width: 440rpx;
  height: 410rpx;
  margin: 12rpx auto 2rpx;
}

.closing-education {
  color: #30495b;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 49rpx;
}

.gold-emphasis {
  margin: 0 6rpx;
  color: #ac6e08;
  font-weight: 900;
}

.subject-card {
  margin-top: 30rpx;
}

.subject-area {
  position: relative;
  margin-top: 30rpx;
}

.subject-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.subject-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 142rpx;
  gap: 18rpx;
  padding: 20rpx 154rpx 20rpx 20rpx;
  border: 1rpx solid rgba(22, 139, 82, 0.22);
  border-radius: 24rpx;
  background: #f1fbf2;
}

.subject-pill--math {
  border-color: rgba(37, 126, 222, 0.24);
  background: #f1f7ff;
}

.subject-pill--chinese {
  border-color: rgba(239, 124, 11, 0.27);
  background: #fff8e9;
}

.subject-key {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #159453;
  color: #ffffff;
  font-size: 35rpx;
  font-weight: 900;
  line-height: 70rpx;
  flex: 0 0 auto;
}

.subject-pill--math .subject-key {
  background: #2b7fdb;
}

.subject-pill--chinese .subject-key {
  background: #ef7c0b;
}

.subject-text {
  min-width: 0;
  color: #14784a;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 46rpx;
  flex: 1;
}

.subject-pill--math .subject-text {
  color: #2474cb;
}

.subject-pill--chinese .subject-text {
  color: #df6908;
}

.subject-art {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 132rpx;
  height: 456rpx;
}

.final-copy {
  margin-top: 24rpx;
  color: #18354a;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 48rpx;
}

.assessment-bar {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 126rpx;
  margin-top: 30rpx;
  padding: 20rpx 28rpx;
  border-radius: 30rpx;
  background: #0b804a;
  box-shadow: 0 16rpx 34rpx rgba(24, 82, 57, 0.23);
}

.assessment-bar:active {
  background: #076d3e;
  transform: scale(0.99);
}

.assessment-icon {
  width: 70rpx;
  height: 70rpx;
  margin-right: 22rpx;
  flex: 0 0 auto;
}

.assessment-copy {
  min-width: 0;
  flex: 1;
}

.assessment-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.assessment-subtitle {
  margin-top: 3rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 27rpx;
  line-height: 37rpx;
}

.assessment-arrow {
  width: 34rpx;
  height: 34rpx;
  margin-left: 18rpx;
  flex: 0 0 34rpx;
}

.safe-bottom {
  height: calc(46rpx + env(safe-area-inset-bottom));
}

@media screen and (max-width: 340px) {
  .poster {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .hero-poster {
    min-height: 720rpx;
    margin-right: -22rpx;
    margin-left: -22rpx;
  }

  .hero-copy {
    top: 48rpx;
    right: 22rpx;
    width: 332rpx;
  }

  .hero-title {
    font-size: 49rpx;
  }

  .hero-quote {
    width: 100%;
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .hero-tree {
    bottom: 112rpx;
    left: -48rpx;
    width: 360rpx;
    height: 520rpx;
  }

  .hero-definition {
    right: 24rpx;
    left: 24rpx;
  }

  .poster-card {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .section-title {
    font-size: 38rpx;
    line-height: 50rpx;
  }

  .english-art {
    width: 320rpx;
    height: 250rpx;
  }

  .logic-row {
    padding-right: 110rpx;
  }

  .logic-art {
    width: 88rpx;
    height: 84rpx;
  }

  .stage-poster-art,
  .closing-art {
    width: 390rpx;
  }

  .subject-row {
    padding-right: 128rpx;
  }

  .subject-art {
    right: 2rpx;
    width: 112rpx;
  }

  .screen-divider {
    width: calc(100% + 44rpx);
    margin-right: -22rpx;
    margin-left: -22rpx;
  }
}
