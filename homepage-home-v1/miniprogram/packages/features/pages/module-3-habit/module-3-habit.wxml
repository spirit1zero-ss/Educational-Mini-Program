<view class="page page--habit">
  <custom-nav title="学习习惯" showBack="{{true}}" showHome="{{true}}"></custom-nav>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="module-long">
      <view class="hero-poster">
        <image class="hero-landscape" src="{{dividerImage}}" mode="aspectFill" data-cloud-field="dividerImage" binderror="onCloudImageError"></image>
        <image class="hero-art" src="{{heroIllustration}}" mode="aspectFit" data-cloud-field="heroIllustration" binderror="onCloudImageError"></image>
        <view class="hero-copy">
          <view class="hero-title">学习方法比学科知识更重要！</view>
          <view class="hero-quote">
            <view class="quote-mark">“</view>
            <view class="hero-quote-text">{{articleBlocks[0].text}}</view>
            <view class="quote-mark quote-mark--end">”</view>
          </view>
        </view>

        <view class="definition-strip">
          <view class="definition-icon-wrap">
            <image class="definition-icon" src="{{iconBase}}{{articleBlocks[1].icon}}" mode="aspectFit"></image>
          </view>
          <view class="definition-copy">
            <text>{{articleBlocks[1].prefix}}</text>
            <text class="highlight">{{articleBlocks[1].highlight}}</text>
          </view>
        </view>
      </view>

      <view class="poster poster--first">
        <view class="poster-card spotlight-card">
          <image class="spotlight-art" src="{{sectionIllustration}}" mode="aspectFit" data-cloud-field="sectionIllustration" binderror="onCloudImageError"></image>
          <view class="section-head section-head--center">
            <view class="section-index">{{articleBlocks[2].index}}</view>
            <view class="section-title">{{articleBlocks[2].title}}</view>
          </view>
          <view wx:if="{{articleBlocks[2].lines}}" class="section-body">
            <view class="paragraph" wx:for="{{articleBlocks[2].lines}}" wx:key="*this">{{item}}</view>
          </view>
        </view>
      </view>

      <image class="screen-divider" src="{{dividerImage}}" mode="aspectFill" data-cloud-field="dividerImage" binderror="onCloudImageError"></image>

      <view class="poster poster--second">
        <view class="poster-card">
          <view class="section-head">
            <view class="section-index">{{articleBlocks[3].index}}</view>
            <view class="section-title">{{articleBlocks[3].title}}</view>
          </view>
          <view class="section-body">
            <view class="paragraph" wx:for="{{articleBlocks[3].lines}}" wx:key="*this">{{item}}</view>
          </view>
        </view>
      </view>

      <image class="screen-divider" src="{{dividerImage}}" mode="aspectFill" data-cloud-field="dividerImage" binderror="onCloudImageError"></image>

      <view class="poster poster--third">
        <view class="poster-card">
          <view class="section-head">
            <view class="section-index">{{articleBlocks[4].index}}</view>
            <view class="section-title">{{articleBlocks[4].title}}</view>
          </view>
          <view class="section-body">
            <view class="paragraph" wx:for="{{articleBlocks[4].lines}}" wx:key="*this">{{item}}</view>
          </view>
        </view>

        <view class="poster-card closing-card">
          <view class="section-head">
            <view class="section-index">{{articleBlocks[5].index}}</view>
            <view class="section-title">{{articleBlocks[5].title}}</view>
          </view>
          <view class="note-box">
            <image class="note-icon" src="{{iconBase}}callout-star.png" mode="aspectFit"></image>
            <view class="note-text">
              <view wx:for="{{articleBlocks[5].noteLines}}" wx:key="*this">{{item}}</view>
            </view>
          </view>
        </view>

        <view class="assessment-bar" bindtap="onDownloadTap" role="button" aria-label="下载SOP高效作业流程规范表格">
          <image class="assessment-icon" src="{{iconBase}}assessment-clipboard.png" mode="aspectFit"></image>
          <view class="assessment-copy">
            <view class="assessment-title">点击下载表格</view>
            <view class="assessment-subtitle">SOP高效作业流程规范表格</view>
          </view>
          <image class="assessment-arrow" src="/assets/home/home-tap-arrow-white.png" mode="aspectFit"></image>
        </view>

        <view class="safe-bottom"></view>
      </view>
    </view>
  </scroll-view>
</view>
