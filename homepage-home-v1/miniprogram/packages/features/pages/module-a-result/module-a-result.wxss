.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 12%, rgba(216, 166, 64, 0.1), transparent 34%),
    linear-gradient(180deg, #f8faf4 0%, #f3f8f0 48%, #ffffff 100%);
  overflow: hidden;
}

.page-scroll {
  height: calc(100vh - 100px);
}

.content {
  padding: 12rpx 28rpx 0;
}

.result-card {
  padding: 28rpx 28rpx 30rpx;
  border: 1rpx solid rgba(31, 107, 87, 0.1);
  border-radius: 30rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(238, 247, 236, 0.96));
  box-shadow: 0 16rpx 36rpx rgba(31, 42, 36, 0.06);
}

.result-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-tag {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(31, 107, 87, 0.1);
  color: #1f6b57;
  font-size: 22rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.result-type {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #1f6b57;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}

.result-title {
  margin-top: 24rpx;
  color: #183327;
  font-size: 39rpx;
  line-height: 52rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.result-intro {
  margin-top: 10rpx;
  color: #63736b;
  font-size: 25rpx;
  line-height: 36rpx;
}

.combo-strip {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(216, 166, 64, 0.18);
  border-radius: 20rpx;
  background: rgba(255, 250, 240, 0.82);
  color: #8c641e;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 800;
}

.subject-panel,
.reading-panel,
.suggest-panel {
  margin-top: 22rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(31, 107, 87, 0.08);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 36, 0.04);
}

.section-title {
  color: #1f2a24;
  font-size: 31rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.trait-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trait-item {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f7faf5;
}

.trait-subject {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 56rpx;
  margin-right: 18rpx;
  border-radius: 999rpx;
  background: #eef7ec;
  color: #1f6b57;
  font-size: 25rpx;
  line-height: 56rpx;
  font-weight: 800;
  flex: 0 0 auto;
}

.trait-copy {
  min-width: 0;
  flex: 1;
}

.trait-title {
  color: #22332d;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.trait-desc {
  margin-top: 4rpx;
  color: #7a8982;
  font-size: 22rpx;
  line-height: 30rpx;
}

.reading-body {
  margin-top: 18rpx;
  color: #34443d;
  font-size: 27rpx;
  line-height: 44rpx;
}

.suggest-panel {
  border-color: rgba(216, 166, 64, 0.2);
  background: linear-gradient(135deg, #fffaf0 0%, #ffffff 100%);
}

.suggest-label {
  color: #9a6f22;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 800;
}

.suggest-title {
  margin-top: 8rpx;
  color: #1d2b26;
  font-size: 31rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.suggest-desc {
  margin-top: 8rpx;
  color: #7a8982;
  font-size: 24rpx;
  line-height: 34rpx;
}

.bottom-spacer {
  height: 174rpx;
}

@media screen and (max-width: 340px) {
  .result-title {
    font-size: 34rpx;
    line-height: 46rpx;
  }

  .combo-strip,
  .reading-body {
    font-size: 24rpx;
  }

  .trait-item {
    align-items: flex-start;
  }
}
