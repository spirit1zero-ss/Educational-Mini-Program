<view class="page">
  <view class="custom-nav" style="{{navStyle}}">
    <view class="back-button" bindtap="onBackTap">‹</view>
    <view class="nav-title">我的收益</view>
  </view>

  <scroll-view class="records-scroll" style="{{scrollStyle}}" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view class="summary-card">
        <view class="summary-head">
          <view>
            <view class="summary-kicker">推广收益</view>
            <view class="summary-title">训练营推广奖励</view>
            <view class="summary-desc">推荐人 UID：{{memberUid}}</view>
          </view>
          <image class="summary-icon" src="/assets/mine/icon-income.svg" mode="aspectFit"></image>
        </view>

        <view class="summary-stats summary-stats--income">
          <view class="summary-stat" wx:for="{{summary}}" wx:key="key">
            <view class="summary-value">{{item.value}}</view>
            <view class="summary-label">{{item.label}}</view>
          </view>
        </view>

        <view class="income-debt-alert" wx:if="{{debtActive}}">
          <view class="income-debt-title">待抵扣佣金 ¥{{debtAmount}}</view>
          <view class="income-debt-desc">退款订单对应佣金已扣回，后续返佣将优先用于抵扣，清零后才可提现。</view>
        </view>

        <view class="action-row">
          <view class="secondary-entry" bindtap="onInviteTap">查看我的团队</view>
          <view
            class="primary-entry {{withdrawal && !withdrawal.windowOpen ? 'primary-entry--disabled' : ''}}"
            bindtap="onWithdrawTap"
          >
            {{withdrawal && !withdrawal.windowOpen ? '暂未开放' : '申请提现'}}
          </view>
        </view>
        <view class="withdraw-window-tip" wx:if="{{withdrawal}}">{{withdrawal.windowNotice}}</view>
      </view>

      <view class="status-tabs">
        <view
          class="status-tab {{activeStatus === item.key ? 'status-tab--active' : ''}}"
          wx:for="{{statusTabs}}"
          wx:key="key"
          bindtap="onStatusTap"
          data-key="{{item.key}}"
        >
          <view class="status-text">{{item.text}}</view>
          <view class="status-count">{{item.count}}</view>
        </view>
      </view>

      <view class="records-panel" wx:if="{{filteredRecords.length}}">
        <view class="record-row" wx:for="{{filteredRecords}}" wx:key="id">
          <view class="record-avatar">
            <image class="record-icon" src="/assets/mine/icon-income.svg" mode="aspectFit"></image>
          </view>
          <view class="record-main">
            <view class="record-top">
              <view class="record-name">{{item.title}}</view>
              <view class="status-badge status-badge--{{item.status}}">{{item.statusText}}</view>
            </view>
            <view class="record-phone">{{item.desc}}</view>
            <view class="record-meta">{{item.time}}</view>
          </view>
          <view class="reward-box">
            <view class="reward-value reward-value--{{item.status}}">{{item.amount}}</view>
          </view>
        </view>
      </view>

      <view class="empty-panel" wx:else>
        <image class="empty-icon" src="/assets/mine/icon-income.svg" mode="aspectFit"></image>
        <view class="empty-title">暂无对应收益记录</view>
        <view class="empty-desc">邀请好友报名后，奖励会在这里展示</view>
        <view class="empty-button" bindtap="onInviteTap">查看我的团队</view>
      </view>
    </view>
  </scroll-view>

  <view class="withdraw-mask" wx:if="{{withdrawalVisible}}" bindtap="closeWithdrawal">
    <view class="withdraw-dialog" catchtap="noop">
      <view class="withdraw-title">申请提现</view>
      <view class="withdraw-tip">可提现 {{withdrawal.availableAmount}} 元，最低 {{withdrawal.minAmount}} 元</view>

      <view class="withdraw-methods">
        <view
          class="withdraw-method {{withdrawalMethod === 'weixin' ? 'withdraw-method--active' : ''}}"
          data-method="weixin"
          bindtap="onWithdrawalMethodTap"
        >
          <view class="withdraw-method-name">微信零钱</view>
          <view class="withdraw-method-desc">审核后发起微信收款</view>
        </view>
        <view
          wx:if="{{bankWithdrawalEnabled}}"
          class="withdraw-method {{withdrawalMethod === 'bank' ? 'withdraw-method--active' : ''}} {{!bankWithdrawalEnabled ? 'withdraw-method--disabled' : ''}}"
          data-method="bank"
          bindtap="onWithdrawalMethodTap"
        >
          <view class="withdraw-method-name">银行卡</view>
          <view class="withdraw-method-desc">{{bankWithdrawalEnabled ? '人工审核后银行转账' : '暂未开放'}}</view>
        </view>
      </view>

      <view class="bank-guide" wx:if="{{withdrawalMethod === 'bank'}}">
        <view class="bank-guide-title">填写前请确认</view>
        <view class="bank-guide-line">1. 仅填写本人可正常收款的银行卡。</view>
        <view class="bank-guide-line">2. 姓名须与银行开户信息保持一致。</view>
        <view class="bank-guide-line">3. 提交后由财务审核并线下转账，可在账单查看进度。</view>
        <view class="bank-guide-safe">银行卡资料会加密保存，仅授权财务在付款处理中查看。</view>
      </view>

      <view class="bank-fields" wx:if="{{withdrawalMethod === 'bank'}}">
        <view class="bank-field">
          <view class="bank-field-label">开户姓名</view>
          <input
            class="bank-field-input"
            value="{{bankRealName}}"
            maxlength="64"
            bindinput="onBankRealNameInput"
            placeholder="请输入真实姓名"
          />
        </view>
        <view class="bank-field">
          <view class="bank-field-label">银行卡号</view>
          <input
            class="bank-field-input"
            type="number"
            value="{{bankCard}}"
            maxlength="19"
            bindinput="onBankCardInput"
            placeholder="请输入本人银行卡号"
          />
        </view>
        <view class="bank-field">
          <view class="bank-field-label">开户银行</view>
          <input
            class="bank-field-input"
            value="{{bankName}}"
            maxlength="100"
            bindinput="onBankNameInput"
            placeholder="如：中国工商银行北京××支行"
          />
        </view>
        <view class="bank-consent" bindtap="onBankConsentTap">
          <view class="bank-consent-check {{bankConsent ? 'bank-consent-check--active' : ''}}">{{bankConsent ? '✓' : ''}}</view>
          <view class="bank-consent-text">
            我已阅读并同意平台为本次提现处理、加密保存并向授权财务人员展示上述收款信息。
            <text class="bank-consent-link" catchtap="onOpenPrivacy">查看《隐私政策》</text>
          </view>
        </view>
      </view>

      <view class="withdraw-input-row">
        <text class="withdraw-currency">¥</text>
        <input class="withdraw-input" type="digit" value="{{withdrawalAmount}}" bindinput="onWithdrawalAmountInput" placeholder="请输入提现金额" />
      </view>
      <view class="withdraw-fee" wx:if="{{withdrawal.feeRate > 0}}">提现手续费：{{withdrawal.feeRate}}%</view>
      <view class="withdraw-actions">
        <button class="withdraw-cancel" bindtap="closeWithdrawal">取消</button>
        <button class="withdraw-submit" loading="{{withdrawalSubmitting}}" bindtap="submitWithdrawal">提交审核</button>
      </view>
    </view>
  </view>

  <view class="transfer-confirm" wx:if="{{pendingTransfer}}">
    <view>
      <view class="transfer-confirm-title">有一笔提现待确认收款</view>
      <view class="transfer-confirm-desc">实际到账 ¥{{pendingTransfer.receivedAmount}} · {{pendingTransfer.addTime}}</view>
    </view>
    <button class="transfer-confirm-button" data-id="{{pendingTransfer.id}}" bindtap="onConfirmTransfer">确认收款</button>
  </view>
</view>
