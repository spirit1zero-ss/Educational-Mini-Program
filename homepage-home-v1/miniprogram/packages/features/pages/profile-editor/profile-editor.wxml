<view class="page">
  <custom-nav title="个人资料" showBack="{{true}}" showHome="{{true}}"></custom-nav>

  <scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view class="intro-card">
        <view class="intro-title">完善个人资料</view>
        <view class="intro-desc">更新后，“我的团队”等页面会展示您最新保存的头像和昵称。</view>
      </view>

      <view class="form-card">
        <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <view class="avatar-frame">
            <image
              class="avatar-image"
              src="{{profile.avatarUrl}}"
              mode="aspectFill"
              binderror="onAvatarError"
            ></image>
            <view class="avatar-edit">更换</view>
          </view>
          <view class="avatar-title">点击更换头像</view>
          <view class="avatar-desc">仅支持 JPG、PNG、WebP 图片，大小不超过 1MB</view>
        </button>

        <view class="field-row">
          <view class="field-label">昵称</view>
          <input
            class="field-input"
            type="nickname"
            maxlength="20"
            value="{{profile.nickname}}"
            placeholder="请选择微信昵称或输入称呼"
            data-field="nickname"
            bindinput="onProfileInput"
          />
        </view>

        <view class="field-row">
          <view class="field-label">手机号</view>
          <input
            class="field-input"
            type="number"
            maxlength="11"
            value="{{profile.phone}}"
            placeholder="请输入11位手机号"
            data-field="phone"
            bindinput="onProfileInput"
          />
        </view>

        <view class="helper-text">请填写真实手机号，方便助教老师联系。</view>
      </view>

      <view class="privacy-card">
        <view class="privacy-title">资料用途</view>
        <view class="privacy-line">头像和昵称用于会员身份及团队成员展示。</view>
        <view class="privacy-line">手机号仅用于助教联系和会员资料核验。</view>
      </view>

      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <view class="save-bar">
    <button
      class="save-button {{(loading || submitting) ? 'save-button--disabled' : ''}}"
      loading="{{loading || submitting}}"
      disabled="{{loading || submitting}}"
      bindtap="onSaveTap"
    >
      保存个人资料
    </button>
  </view>
</view>

<login-consent-modal></login-consent-modal>
