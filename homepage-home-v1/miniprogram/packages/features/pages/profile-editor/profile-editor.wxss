.page {
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 88% 8%, rgba(246, 211, 105, 0.13), transparent 25%),
    linear-gradient(180deg, #f7faf4 0%, #f2f7f0 56%, #ffffff 100%);
}

.profile-scroll {
  height: calc(100vh - 100px - 128rpx - env(safe-area-inset-bottom));
}

.content {
  padding: 18rpx 28rpx 40rpx;
}

.intro-card,
.form-card,
.privacy-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(38, 103, 71, 0.09);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 34rpx rgba(28, 74, 51, 0.055);
}

.intro-card {
  padding: 30rpx 28rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(248, 217, 117, 0.2), transparent 32%),
    linear-gradient(145deg, #f2fbf4 0%, #ffffff 76%);
}

.intro-title {
  color: #163a2a;
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 900;
}

.intro-desc {
  margin-top: 10rpx;
  color: #687b70;
  font-size: 24rpx;
  line-height: 38rpx;
}

.form-card {
  margin-top: 22rpx;
  padding: 34rpx 28rpx 30rpx;
}

.avatar-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0;
  padding: 0 0 30rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: normal;
}

.avatar-button::after,
.save-button::after {
  border: 0;
}

.avatar-frame {
  position: relative;
  width: 154rpx;
  height: 154rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
  overflow: hidden;
  box-sizing: border-box;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  background: #edf3ef;
  box-shadow: 0 14rpx 34rpx rgba(27, 104, 68, 0.17);
}

.avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 68rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border: 4rpx solid #ffffff;
  border-radius: 999rpx;
  background: #168455;
  color: #ffffff;
  font-size: 19rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.avatar-title {
  margin-top: 18rpx;
  color: #244638;
  font-size: 27rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.avatar-desc {
  margin-top: 7rpx;
  color: #8a978f;
  font-size: 21rpx;
  line-height: 32rpx;
}

.field-row {
  display: flex;
  align-items: center;
  min-height: 94rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dfeae3;
  border-radius: 22rpx;
  background: #f8fbf9;
}

.field-label {
  width: 112rpx;
  flex: 0 0 auto;
  color: #244638;
  font-size: 27rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.field-input {
  height: 94rpx;
  color: #203b2f;
  font-size: 27rpx;
  line-height: 94rpx;
  flex: 1;
}

.helper-text {
  margin: 20rpx 6rpx 0;
  color: #718178;
  font-size: 23rpx;
  line-height: 36rpx;
}

.privacy-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.privacy-title {
  color: #234537;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.privacy-line {
  position: relative;
  margin-top: 12rpx;
  padding-left: 22rpx;
  color: #6c7d73;
  font-size: 23rpx;
  line-height: 36rpx;
}

.privacy-line::before {
  position: absolute;
  top: 14rpx;
  left: 2rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #d1a446;
  content: "";
}

.bottom-spacer {
  height: 34rpx;
}

.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  height: calc(128rpx + env(safe-area-inset-bottom));
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -12rpx 30rpx rgba(31, 42, 36, 0.05);
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #15975f 0%, #0d754c 100%);
  color: #ffffff;
  font-size: 29rpx;
  line-height: 90rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 30rpx rgba(15, 117, 76, 0.2);
}

.save-button--disabled {
  background: #c7d9ce;
  color: rgba(255, 255, 255, 0.88);
  box-shadow: none;
}
