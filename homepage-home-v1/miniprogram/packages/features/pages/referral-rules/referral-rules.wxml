<view class="page">
  <custom-nav title="分销规则" showBack="{{true}}" showHome="{{true}}"></custom-nav>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view class="summary-card">
        <view class="summary-head">
          <view>
            <view class="summary-kicker">邀请奖励说明</view>
            <view class="summary-title">邀请好友报名，获得推广奖励</view>
            <view class="summary-desc">通过专属推广海报分享训练营，好友完成报名后，后台会记录邀请关系和奖励数据。</view>
          </view>
          <image class="summary-icon" src="{{heroIcon}}" mode="aspectFit"></image>
        </view>
      </view>

      <view class="section-card">
        <view class="section-title">推广流程</view>
        <view class="step-list">
          <view class="step-row" wx:for="{{steps}}" wx:for-index="index" wx:key="title">
            <view class="step-index">{{index + 1}}</view>
            <view class="step-copy">
              <view class="step-title">{{item.title}}</view>
              <view class="step-desc">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="section-card">
        <view class="section-title">规则说明</view>
        <view class="rule-list">
          <view class="rule-row" wx:for="{{rules}}" wx:key="title">
            <view class="rule-title">{{item.title}}</view>
            <view class="rule-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>

      <view class="section-card note-card">
        <view class="section-title">注意事项</view>
        <view class="note-line" wx:for="{{notices}}" wx:key="*this">{{item}}</view>
      </view>
    </view>
  </scroll-view>
</view>
