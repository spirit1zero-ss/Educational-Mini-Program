@import "../member-benefits/member-benefits.wxss";

.summary-card::after {
  background: rgba(47, 107, 67, 0.1);
}

.summary-icon {
  background: rgba(47, 107, 67, 0.08);
}

.step-list,
.rule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.step-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  border: 1rpx solid rgba(47, 107, 67, 0.08);
  border-radius: 18rpx;
  background: linear-gradient(90deg, #f5faf3 0%, #ffffff 100%);
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #245c4a;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 42rpx;
  flex: 0 0 auto;
}

.step-copy {
  min-width: 0;
  flex: 1;
}

.step-title,
.rule-title {
  color: #105035;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.step-desc,
.rule-desc {
  margin-top: 5rpx;
  color: #647168;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.rule-row {
  padding: 20rpx;
  border: 1rpx solid rgba(47, 107, 67, 0.08);
  border-radius: 18rpx;
  background: #fbfdf9;
}
