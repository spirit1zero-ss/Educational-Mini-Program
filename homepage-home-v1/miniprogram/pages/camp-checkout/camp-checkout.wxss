.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 4%, rgba(214, 168, 74, 0.08), transparent 32%),
    linear-gradient(180deg, #f8faf4 0%, #f5f8f0 54%, #ffffff 100%);
  overflow: hidden;
}

.checkout-scroll {
  height: calc(100vh - 100px - 148rpx - env(safe-area-inset-bottom));
}

.content {
  padding: 0 30rpx;
}

.order-hero,
.info-card,
.notice-card {
  border: 1rpx solid rgba(15, 90, 61, 0.1);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 36, 0.05);
}

.order-hero {
  padding: 30rpx 28rpx 28rpx;
  background:
    radial-gradient(circle at 90% 0%, rgba(214, 168, 74, 0.15), transparent 38%),
    linear-gradient(135deg, #ffffff 0%, #f3faf2 100%);
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef7ec;
  color: #105035;
  font-size: 22rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.hero-title {
  margin-top: 18rpx;
  color: #10482f;
  font-size: 42rpx;
  line-height: 52rpx;
  font-weight: 900;
}

.hero-desc {
  margin-top: 8rpx;
  color: #607066;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.hero-price {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}

.price-symbol {
  color: #bd8428;
  font-size: 30rpx;
  font-weight: 900;
}

.price-value {
  color: #bd8428;
  font-size: 62rpx;
  line-height: 70rpx;
  font-weight: 900;
}

.price-origin {
  margin-left: 18rpx;
  color: #9aa59d;
  font-size: 24rpx;
  line-height: 32rpx;
  text-decoration: line-through;
}

.info-card,
.notice-card {
  margin-top: 18rpx;
  padding: 24rpx;
}

.card-title,
.notice-title {
  color: #1d2b26;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.benefit-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 18rpx 8rpx 16rpx;
  border: 1rpx solid rgba(15, 90, 61, 0.08);
  border-radius: 18rpx;
  background: #fbfdf9;
  text-align: center;
}

.benefit-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 18rpx;
  background: #eef7ec;
  flex: 0 0 auto;
}

.benefit-icon {
  width: 50rpx;
  height: 50rpx;
}

.benefit-title {
  margin-top: 12rpx;
  color: #105035;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.benefit-desc {
  margin-top: 4rpx;
  color: #6d7b72;
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 600;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(31, 42, 36, 0.07);
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  color: #7a877f;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 700;
  flex: 0 0 auto;
}

.detail-value {
  color: #27362f;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 800;
  text-align: right;
}

.payment-value {
  color: #105035;
}

.detail-row--total {
  align-items: center;
}

.total-price {
  color: #bd8428;
  font-size: 38rpx;
  line-height: 46rpx;
  font-weight: 900;
}

.notice-card {
  background: linear-gradient(135deg, #fffaf0 0%, #ffffff 100%);
  border-color: rgba(214, 168, 74, 0.18);
}

.notice-line {
  position: relative;
  margin-top: 14rpx;
  padding-left: 22rpx;
  color: #5f6c64;
  font-size: 23rpx;
  line-height: 34rpx;
  font-weight: 600;
}

.notice-line::before {
  position: absolute;
  top: 13rpx;
  left: 2rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d6a84a;
  content: "";
}

.agreement-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 4rpx 4rpx 0;
}

.check-dot {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  border: 2rpx solid rgba(15, 90, 61, 0.26);
  border-radius: 50%;
  background: #ffffff;
  flex: 0 0 auto;
}

.check-dot--active {
  border-color: #0f5a3d;
  background: #0f5a3d;
}

.check-dot--active::after {
  position: absolute;
  left: 9rpx;
  top: 5rpx;
  width: 10rpx;
  height: 16rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
  content: "";
}

.agreement-copy {
  color: #66736b;
  font-size: 22rpx;
  line-height: 34rpx;
  font-weight: 600;
}

.bottom-spacer {
  height: 42rpx;
}

.pay-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  height: calc(148rpx + env(safe-area-inset-bottom));
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -12rpx 30rpx rgba(31, 42, 36, 0.05);
}

.pay-summary {
  min-width: 150rpx;
  flex: 0 0 auto;
}

.pay-label {
  color: #7a877f;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 700;
}

.pay-price {
  margin-top: 4rpx;
  color: #bd8428;
  font-size: 38rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.pay-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: #0f6d4a;
  color: #ffffff;
  font-size: 29rpx;
  line-height: 36rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(15, 109, 74, 0.2);
  flex: 1;
}

.pay-button--disabled {
  background: #dbe5df;
  color: #8c9991;
  box-shadow: none;
}

@media screen and (max-width: 340px) {
  .benefit-grid {
    grid-template-columns: 1fr;
  }

  .pay-button {
    font-size: 26rpx;
  }
}
