<view class="page">
  <view class="safe-header" style="{{safeTopStyle}}" aria-hidden="true"></view>

  <home-hero modules="{{modules}}" bind:select="onEntrySelect"></home-hero>

  <view class="action-list">
    <home-action-row
      wx:for="{{actions}}"
      wx:key="key"
      item="{{item}}"
      bind:select="onEntrySelect"
    ></home-action-row>
  </view>

  <view class="tabbar-placeholder" style="{{bottomPlaceholderStyle}}" aria-hidden="true"></view>

  <home-tabbar
    tabs="{{tabs}}"
    active="home"
    safe-bottom="{{safeBottom}}"
    bind:change="onTabChange"
  ></home-tabbar>
</view>
