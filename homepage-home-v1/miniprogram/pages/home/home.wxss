.page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #f8faf4 0%, #f6f8f0 45%, #ffffff 100%);
  overflow: hidden;
}

.custom-nav {
  min-height: 88px;
  padding: 44px 110px 18rpx 32rpx;
  background: rgba(248, 250, 244, 0.94);
}

.nav-title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #1f2a24;
  white-space: nowrap;
}

.home-scroll {
  height: calc(100vh - 88px - 120rpx);
}

.content {
  padding: 0 28rpx 44rpx;
}

.intro {
  padding: 6rpx 4rpx 18rpx;
}

.intro-kicker {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(36, 92, 74, 0.14);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #477160;
  font-size: 22rpx;
  font-weight: 600;
}

.intro-title {
  margin-top: 18rpx;
  color: #183327;
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.intro-subtitle {
  margin-top: 10rpx;
  color: #6d786f;
  font-size: 25rpx;
  line-height: 36rpx;
}

.model-panel {
  position: relative;
  min-height: 370rpx;
  margin-top: 12rpx;
  border: 1rpx solid rgba(36, 92, 74, 0.08);
  border-radius: 28rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(240, 247, 234, 0.82));
  overflow: hidden;
}

.tree-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.module-stack {
  position: absolute;
  inset: 0;
}

.module-card {
  position: absolute;
  right: 20rpx;
  display: flex;
  align-items: center;
  width: 252rpx;
  min-height: 76rpx;
  padding: 15rpx 18rpx 15rpx 20rpx;
  border: 1rpx solid rgba(36, 92, 74, 0.09);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 18rpx rgba(36, 92, 74, 0.045);
  backdrop-filter: blur(8px);
}

.module-card--top {
  top: 42rpx;
}

.module-card--middle {
  top: 151rpx;
}

.module-card--bottom {
  top: 260rpx;
}

.module-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #c99a43;
  box-shadow: 0 0 0 8rpx rgba(201, 154, 67, 0.12);
  flex: 0 0 auto;
}

.module-copy {
  min-width: 0;
}

.module-title {
  color: #183327;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.module-subtitle {
  margin-top: 5rpx;
  color: #788379;
  font-size: 21rpx;
  line-height: 28rpx;
  white-space: nowrap;
}

.section-heading {
  display: block;
  margin: 32rpx 4rpx 18rpx;
}

.section-title {
  color: #1f2a24;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
  white-space: nowrap;
}

.section-note {
  margin-top: 6rpx;
  color: #889287;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: left;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.action-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 126rpx;
  padding: 22rpx 20rpx 22rpx 28rpx;
  border: 1rpx solid rgba(36, 92, 74, 0.08);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 36, 0.04);
  overflow: hidden;
}

.action-card::before {
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #245c4a;
  content: "";
}

.action-card--heart::before {
  background: #c99a43;
}

.action-card--download::before {
  background: #477160;
}

.action-card:active {
  transform: scale(0.99);
  background: #fbfdf9;
}

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title {
  color: #1f2a24;
  font-size: 29rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.action-desc {
  margin-top: 6rpx;
  color: #748076;
  font-size: 23rpx;
  line-height: 32rpx;
}

.action-button {
  min-width: 92rpx;
  height: 50rpx;
  margin-left: 16rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #245c4a;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 50rpx;
  text-align: center;
  font-weight: 600;
  flex: 0 0 auto;
}

.action-card--download .action-button {
  background: #f2f7ef;
  color: #245c4a;
}

.camp-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(201, 154, 67, 0.18);
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fffaf0 0%, #fbfdf8 100%);
}

.camp-title {
  color: #2b3a31;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.camp-desc {
  margin-top: 5rpx;
  color: #7e877d;
  font-size: 22rpx;
  line-height: 30rpx;
}

.camp-price {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(201, 154, 67, 0.14);
  color: #9a6f22;
  font-size: 22rpx;
  line-height: 48rpx;
  font-weight: 700;
  white-space: nowrap;
}

.bottom-tab {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
  background: rgba(255, 255, 255, 0.96);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a948b;
}

.tab-item--active {
  color: #245c4a;
}

.tab-text {
  position: relative;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 600;
}

.tab-item--active .tab-text {
  background: #eef7ec;
}

@media screen and (max-width: 340px) {
  .module-card {
    right: 16rpx;
    width: 244rpx;
  }

  .module-subtitle,
  .action-desc {
    font-size: 21rpx;
  }
}
