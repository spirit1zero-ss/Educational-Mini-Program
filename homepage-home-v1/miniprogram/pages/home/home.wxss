.page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fbfdf8 0%, #f7fbf3 42%, #ffffff 100%);
  overflow: hidden;
}

.custom-nav {
  min-height: 88px;
  padding: 44px 132rpx 10rpx 34rpx;
  background: rgba(251, 253, 248, 0.96);
}

.nav-title {
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 800;
  color: #193326;
  white-space: nowrap;
}

.home-scroll {
  height: calc(100vh - 88px - 112rpx - env(safe-area-inset-bottom));
}

.content {
  padding: 0 26rpx 44rpx;
}

.hero-card {
  padding: 30rpx 26rpx 20rpx;
  border: 1rpx solid rgba(31, 107, 87, 0.06);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 10% 4%, rgba(240, 248, 235, 0.92), transparent 48%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 251, 242, 0.94));
  box-shadow: 0 14rpx 34rpx rgba(31, 42, 36, 0.045);
  overflow: hidden;
}

.intro {
  padding: 0 0 18rpx;
}

.intro-title {
  color: #183327;
  font-size: 37rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.intro-subtitle {
  margin-top: 8rpx;
  color: #5f6c64;
  font-size: 23rpx;
  line-height: 33rpx;
  font-weight: 700;
}

.model-panel {
  position: relative;
  min-height: 378rpx;
  margin-top: 2rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.tree-image {
  position: absolute;
  left: -34rpx;
  top: -10rpx;
  width: 112%;
  height: 100%;
}

.module-stack {
  position: absolute;
  inset: 0;
}

.module-card {
  position: absolute;
  right: 0;
  display: flex;
  align-items: center;
  width: 270rpx;
  min-height: 86rpx;
  padding: 16rpx 12rpx 16rpx 15rpx;
  border: 1rpx solid rgba(31, 107, 87, 0.08);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 26rpx rgba(31, 42, 36, 0.08);
}

.module-card--top {
  top: 26rpx;
}

.module-card--middle {
  top: 142rpx;
}

.module-card--bottom {
  top: 258rpx;
}

.module-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 13rpx;
  border-radius: 14rpx;
  background: #e7f4e9;
  flex: 0 0 auto;
}

.module-icon {
  width: 43rpx;
  height: 43rpx;
}

.module-copy {
  min-width: 0;
  flex: 1;
}

.module-title {
  color: #183327;
  font-size: 27rpx;
  line-height: 33rpx;
  font-weight: 900;
}

.module-subtitle {
  margin-top: 3rpx;
  color: #66736b;
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.module-arrow {
  margin-left: 8rpx;
  color: #9ba8a0;
  font-size: 34rpx;
  line-height: 34rpx;
}

.entry-panel {
  margin-top: 18rpx;
  padding: 24rpx 18rpx 18rpx;
  border: 1rpx solid rgba(31, 107, 87, 0.07);
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(31, 42, 36, 0.045);
}

.section-heading {
  display: flex;
  align-items: center;
  margin: 0 0 18rpx;
}

.section-mark {
  width: 8rpx;
  height: 34rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #1f6b57;
}

.section-title {
  color: #203129;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
  white-space: nowrap;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-card {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 15rpx 14rpx 15rpx 16rpx;
  border: 1rpx solid rgba(31, 107, 87, 0.1);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: none;
  overflow: hidden;
}

.action-card:active {
  transform: scale(0.99);
  background: #fbfdf9;
}

.action-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
  border-radius: 14rpx;
  background: #e7f4e9;
  flex: 0 0 auto;
}

.action-icon {
  width: 46rpx;
  height: 46rpx;
}

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title {
  color: #1c2f27;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.action-desc {
  margin-top: 3rpx;
  color: #627067;
  font-size: 21rpx;
  line-height: 29rpx;
  font-weight: 600;
}

.action-button {
  min-width: 98rpx;
  height: 48rpx;
  margin-left: 16rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(31, 107, 87, 0.32);
  border-radius: 999rpx;
  background: #ffffff;
  color: #245c4a;
  font-size: 22rpx;
  line-height: 46rpx;
  text-align: center;
  font-weight: 800;
  flex: 0 0 auto;
}

.action-card--download .action-button {
  background: #f7fbf3;
}

.button-arrow {
  font-size: 22rpx;
  line-height: 1;
}

.camp-strip {
  display: flex;
  align-items: center;
  min-height: 90rpx;
  margin-top: 18rpx;
  padding: 15rpx 16rpx;
  border: 1rpx solid rgba(31, 107, 87, 0.06);
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f6fbf1 0%, #fffaf0 100%);
}

.camp-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  flex: 0 0 auto;
}

.camp-icon {
  width: 44rpx;
  height: 44rpx;
}

.camp-copy {
  flex: 1;
  min-width: 0;
}

.camp-title {
  color: #245c4a;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.camp-desc {
  margin-top: 3rpx;
  color: #647168;
  font-size: 21rpx;
  line-height: 29rpx;
  font-weight: 600;
}

.camp-price {
  height: 46rpx;
  margin-left: 12rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(247, 199, 91, 0.28);
  color: #9a6f22;
  font-size: 21rpx;
  line-height: 46rpx;
  font-weight: 900;
  white-space: nowrap;
}

.camp-arrow {
  margin-left: 10rpx;
  color: #9ba8a0;
  font-size: 34rpx;
  line-height: 34rpx;
}

.bottom-tab {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  box-sizing: border-box;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
  background: rgba(255, 255, 255, 0.96);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  color: #8a948b;
}

.tab-item--active {
  color: #245c4a;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 700;
}

.tab-icon {
  width: 36rpx;
  height: 36rpx;
}

@media screen and (max-width: 340px) {
  .module-card {
    right: 16rpx;
    width: 244rpx;
  }

  .module-subtitle,
  .action-desc {
    font-size: 21rpx;
  }
}
