page,
.page {
  min-height: 100%;
  background: #ffffff;
}

.page {
  width: 750rpx;
  overflow-x: hidden;
}

.safe-header {
  width: 750rpx;
  background: #bfeaff;
}

.action-list {
  position: relative;
  z-index: 5;
  box-sizing: border-box;
  width: 750rpx;
  padding: 14rpx 0 12rpx;
  background: #ffffff;
}

.tabbar-placeholder {
  width: 750rpx;
  background: #ffffff;
}

.hero {
  position: relative;
  width: 750rpx;
  height: 920rpx;
  overflow: hidden;
  background: #c9efff;
}

.hero__background {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  height: 924.17rpx;
}

.hero__heading {
  position: absolute;
  z-index: 2;
  top: 26rpx;
  left: 42rpx;
}

.hero__eyebrow {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #179653;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 54rpx;
  box-shadow: 0 6rpx 18rpx rgba(52, 133, 97, 0.08);
}

.hero__sprout {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.hero__title {
  margin-top: 28rpx;
  color: #07123f;
  font-size: 67rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 1.08;
  white-space: nowrap;
}

.hero__subtitle {
  margin-top: 18rpx;
  color: #425a69;
  font-size: 33rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.hero__module-list {
  position: absolute;
  z-index: 3;
  top: 306rpx;
  right: 34rpx;
  width: 292rpx;
}

.module-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 292rpx;
  height: 156rpx;
  padding: 22rpx 16rpx 18rpx 24rpx;
  border: 2rpx solid rgba(31, 172, 91, 0.38);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(40, 74, 89, 0.1);
  overflow: hidden;
}

.module-card:active {
  opacity: 0.88;
  transform: scale(0.985);
}

.module-card + .module-card {
  margin-top: 34rpx;
}

.module-card--blue {
  border-color: rgba(43, 121, 231, 0.34);
}

.module-card--orange {
  border-color: rgba(255, 138, 16, 0.38);
}

.module-card__copy {
  min-width: 0;
  flex: 1;
}

.module-card__title-row {
  display: flex;
  align-items: center;
}

.module-card__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  border-radius: 50%;
  background: #21a75a;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1;
}

.module-card--blue .module-card__badge {
  background: #287ce5;
}

.module-card--orange .module-card__badge {
  background: #ff880d;
}

.module-card__title {
  margin-left: 15rpx;
  color: #179653;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.1;
  white-space: nowrap;
}

.module-card--blue .module-card__title,
.module-card--blue .module-card__subtitle {
  color: #2877d5;
}

.module-card--orange .module-card__title,
.module-card--orange .module-card__subtitle {
  color: #e57912;
}

.module-card__subtitle {
  display: block;
  margin-top: 18rpx;
  color: #159653;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.25;
  white-space: nowrap;
}

.module-card__visual {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 58rpx;
  margin-left: 6rpx;
  flex: 0 0 58rpx;
}

.module-card__icon {
  width: 50rpx;
  height: 50rpx;
}

.module-card__click-mark {
  display: block;
  box-sizing: border-box;
  width: 38rpx;
  height: 38rpx;
  margin-top: 8rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(31, 172, 91, 0.2);
  border-radius: 12rpx;
  background: rgba(31, 172, 91, 0.08);
  box-shadow: 0 4rpx 10rpx rgba(24, 120, 70, 0.08);
}

.module-card--blue .module-card__click-mark {
  border-color: rgba(43, 121, 231, 0.18);
  background: rgba(43, 121, 231, 0.07);
  box-shadow: 0 4rpx 10rpx rgba(43, 121, 231, 0.07);
}

.module-card--orange .module-card__click-mark {
  border-color: rgba(255, 138, 16, 0.2);
  background: rgba(255, 138, 16, 0.08);
  box-shadow: 0 4rpx 10rpx rgba(205, 102, 8, 0.07);
}

.action-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 680rpx;
  min-height: 146rpx;
  margin: 0 auto 8rpx;
  padding: 22rpx 14rpx 22rpx 18rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 26rpx rgba(24, 54, 80, 0.055);
}

.action-row:active {
  background: #fbfdfb;
}

.action-row__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 90rpx;
  flex: 0 0 90rpx;
}

.action-row__icon {
  width: 82rpx;
  height: 82rpx;
}

.action-row__copy {
  min-width: 0;
  flex: 1;
  margin-left: 16rpx;
}

.action-row__title,
.action-row__description {
  display: block;
}

.action-row__title {
  overflow: hidden;
  color: #15171a;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-row__description {
  margin-top: 12rpx;
  overflow: hidden;
  color: #727782;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-row__end {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 128rpx;
  margin-left: 12rpx;
  flex: 0 0 128rpx;
  transform: translateY(8rpx);
}

.action-row__button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 128rpx;
  min-width: 128rpx;
  height: 54rpx;
  padding: 0;
  flex: 0 0 128rpx;
  border: 2rpx solid #28a366;
  border-radius: 28rpx;
  color: #25995f;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
}

.action-row__button-mark {
  display: block;
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  flex: 0 0 18rpx;
}

.action-row--blue .action-row__button {
  border-color: #2b7ce2;
  color: #2874d1;
}

.action-row--orange .action-row__button {
  border-color: #e99a31;
  color: #dc8516;
}

.action-row--solid .action-row__button {
  border-color: #22aa5d;
  background: #22aa5d;
  color: #ffffff;
}

.tabbar {
  position: fixed;
  z-index: 50;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  width: 750rpx;
  min-height: 118rpx;
  border-top: 1rpx solid rgba(20, 48, 68, 0.05);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(36, 63, 82, 0.04);
}

.tabbar__item {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  width: 250rpx;
  height: 118rpx;
  padding-top: 16rpx;
  flex-direction: column;
  color: #777b85;
}

.tabbar__item--active {
  color: #1daa5a;
}

.tabbar__icon {
  width: 52rpx;
  height: 52rpx;
}

.tabbar__label {
  margin-top: 5rpx;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.2;
}
