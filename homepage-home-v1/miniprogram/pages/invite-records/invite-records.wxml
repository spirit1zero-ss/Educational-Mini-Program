<view class="page">
  <view class="custom-nav" style="{{navStyle}}">
    <view class="back-button" bindtap="onBackTap">‹</view>
    <view class="nav-title">邀请记录</view>
  </view>

  <scroll-view class="records-scroll" style="{{scrollStyle}}" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view class="summary-card">
        <view class="summary-head">
          <view>
            <view class="summary-kicker">会员推广</view>
            <view class="summary-title">邀请好友报名训练营</view>
            <view class="summary-desc">推荐人 UID：{{memberUid}}</view>
          </view>
          <image class="summary-icon" src="../../assets/mine/icon-invite-record.svg" mode="aspectFit"></image>
        </view>

        <view class="summary-stats">
          <view class="summary-stat" wx:for="{{summary}}" wx:key="key">
            <view class="summary-value">{{item.value}}</view>
            <view class="summary-label">{{item.label}}</view>
          </view>
        </view>

        <view class="poster-entry" bindtap="onPosterTap">生成推广海报</view>
      </view>

      <view class="status-tabs">
        <view
          class="status-tab {{activeStatus === item.key ? 'status-tab--active' : ''}}"
          wx:for="{{statusTabs}}"
          wx:key="key"
          bindtap="onStatusTap"
          data-key="{{item.key}}"
        >
          <view class="status-text">{{item.text}}</view>
          <view class="status-count">{{item.count}}</view>
        </view>
      </view>

      <view class="records-panel" wx:if="{{filteredRecords.length}}">
        <view class="record-row" wx:for="{{filteredRecords}}" wx:key="id">
          <view class="record-avatar">{{item.avatar}}</view>
          <view class="record-main">
            <view class="record-top">
              <view class="record-name">{{item.name}}</view>
              <view class="status-badge status-badge--{{item.status}}">{{item.statusText}}</view>
            </view>
            <view class="record-phone">{{item.phone}}</view>
            <view class="record-meta">{{item.source}} · {{item.time}}</view>
          </view>
          <view class="reward-box">
            <view class="reward-value">{{item.reward}}</view>
            <view class="reward-state">{{item.rewardState}}</view>
          </view>
        </view>
      </view>

      <view class="empty-panel" wx:else>
        <image class="empty-icon" src="../../assets/mine/icon-promo-poster.svg" mode="aspectFit"></image>
        <view class="empty-title">暂无对应邀请记录</view>
        <view class="empty-desc">生成推广海报，邀请更多家长了解训练营</view>
        <view class="empty-button" bindtap="onPosterTap">去生成海报</view>
      </view>
    </view>
  </scroll-view>
</view>
