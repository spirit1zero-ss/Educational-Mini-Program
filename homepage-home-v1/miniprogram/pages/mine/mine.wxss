.page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #f8faf4 0%, #f3f6ef 48%, #ffffff 100%);
  overflow: hidden;
}

.custom-nav {
  min-height: 88px;
  padding: 44px 110px 18rpx 32rpx;
  background: rgba(248, 250, 244, 0.94);
}

.nav-title {
  color: #1f2a24;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
  white-space: nowrap;
}

.mine-scroll {
  height: calc(100vh - 88px - 120rpx - env(safe-area-inset-bottom));
}

.content {
  padding: 0 28rpx 44rpx;
}

.camp-card {
  position: relative;
  min-height: 316rpx;
  overflow: hidden;
  border: 1rpx solid rgba(47, 107, 67, 0.09);
  border-radius: 28rpx;
  background: #f7faf2;
}

.camp-card--member {
  min-height: 356rpx;
  border-color: rgba(201, 154, 67, 0.18);
}

.camp-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.camp-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(250, 253, 247, 0.99) 0%, rgba(250, 253, 247, 0.93) 48%, rgba(250, 253, 247, 0.4) 100%);
}

.camp-card--member .camp-overlay {
  background:
    linear-gradient(90deg, rgba(250, 253, 247, 0.99) 0%, rgba(250, 253, 247, 0.92) 48%, rgba(255, 250, 236, 0.38) 100%);
}

.camp-body {
  position: relative;
  z-index: 1;
  width: 70%;
  padding: 26rpx 26rpx 28rpx;
}

.member-row {
  display: flex;
  align-items: center;
  min-height: 42rpx;
}

.member-badge {
  display: inline-flex;
  align-items: center;
  height: 46rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(201, 154, 67, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.9);
  color: #9a6f22;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.member-badge--active {
  border-color: rgba(201, 154, 67, 0.32);
  background: linear-gradient(135deg, rgba(36, 92, 74, 0.96), rgba(47, 107, 67, 0.92));
  color: #fff7dc;
}

.member-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}

.camp-title {
  margin-top: 18rpx;
  color: #183327;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.camp-desc {
  margin-top: 8rpx;
  color: #647168;
  font-size: 23rpx;
  line-height: 32rpx;
}

.uid-line {
  display: inline-flex;
  align-items: center;
  min-height: 34rpx;
  margin-top: 10rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(36, 92, 74, 0.08);
  color: #345645;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.camp-meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.price-chip {
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(201, 154, 67, 0.16);
  color: #9a6f22;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 46rpx;
  white-space: nowrap;
}

.camp-meta--member .price-chip {
  background: rgba(47, 107, 67, 0.12);
  color: #245c4a;
}

.benefit-text {
  margin-left: 12rpx;
  color: #6c786f;
  font-size: 21rpx;
  line-height: 30rpx;
}

.signup-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  height: 62rpx;
  margin-top: 22rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #245c4a;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 62rpx;
  box-shadow: 0 12rpx 24rpx rgba(36, 92, 74, 0.2);
}

.signup-button--member {
  min-width: 210rpx;
  background: linear-gradient(135deg, #245c4a 0%, #2f6b43 100%);
}

.signup-button:active,
.poster-button:active,
.quick-item:active,
.list-row:active {
  transform: scale(0.99);
}

.referral-card,
.quick-grid,
.list-panel {
  border: 1rpx solid rgba(47, 107, 67, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 24rpx rgba(47, 107, 67, 0.045);
}

.referral-card {
  margin-top: 22rpx;
  padding: 24rpx;
}

.referral-card:active {
  transform: scale(0.995);
}

.distribution-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #245c4a 0%, #2f6b43 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 22rpx rgba(36, 92, 74, 0.14);
}

.distribution-entry-title {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.distribution-entry-desc {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 20rpx;
  line-height: 28rpx;
}

.distribution-entry-arrow {
  color: #fff1bd;
  font-size: 44rpx;
  line-height: 44rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: #1f2a24;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.section-desc {
  margin-top: 6rpx;
  color: #748076;
  font-size: 23rpx;
  line-height: 32rpx;
}

.section-icon {
  width: 50rpx;
  height: 50rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #f2f7ef;
}

.identity-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(47, 107, 67, 0.1);
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f2f8f1 0%, #fffaf0 100%);
}

.identity-main {
  display: flex;
  align-items: center;
}

.identity-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border-radius: 18rpx;
  background: #245c4a;
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
}

.identity-name {
  color: #1f2a24;
  font-size: 26rpx;
  font-weight: 800;
}

.identity-code {
  margin-top: 3rpx;
  color: #7b867e;
  font-size: 20rpx;
}

.identity-quota {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
}

.identity-quota-value {
  color: #9a6f22;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.identity-quota-label {
  margin-top: 2rpx;
  color: #8a7a5d;
  font-size: 19rpx;
}

.stats-row {
  display: flex;
  margin-top: 22rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(31, 42, 36, 0.06);
  border-bottom: 1rpx solid rgba(31, 42, 36, 0.06);
}

.stat-item {
  position: relative;
  flex: 1;
  text-align: center;
}

.stat-item + .stat-item::before {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 0;
  width: 1rpx;
  background: rgba(31, 42, 36, 0.08);
  content: "";
}

.stat-value {
  color: #245c4a;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.stat-label {
  margin-top: 5rpx;
  color: #7b867e;
  font-size: 21rpx;
  line-height: 28rpx;
}

.poster-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.poster-button--primary {
  background: linear-gradient(135deg, #2f6b43 0%, #245c4a 100%);
  color: #ffffff;
}

.poster-button--secondary {
  border: 1rpx solid rgba(47, 107, 67, 0.18);
  background: #f2f7ef;
  color: #245c4a;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 22rpx;
  padding: 22rpx 8rpx;
}

.quick-item {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.quick-icon {
  width: 52rpx;
  height: 52rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #f2f7ef;
}

.quick-title {
  margin-top: 11rpx;
  color: #3a443e;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 28rpx;
  text-align: center;
}

.list-panel {
  margin-top: 22rpx;
  overflow: hidden;
}

.list-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 20rpx 24rpx;
}

.list-row + .list-row {
  border-top: 1rpx solid rgba(31, 42, 36, 0.06);
}

.list-icon {
  width: 46rpx;
  height: 46rpx;
  margin-right: 18rpx;
  flex: 0 0 auto;
}

.list-copy {
  min-width: 0;
  flex: 1;
}

.list-title {
  color: #26312b;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.list-desc {
  margin-top: 5rpx;
  color: #879189;
  font-size: 21rpx;
  line-height: 28rpx;
}

.chevron {
  margin-left: 12rpx;
  color: #a3aca5;
  font-size: 42rpx;
  line-height: 42rpx;
}

.bottom-tab {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  box-sizing: border-box;
  height: calc(120rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
  background: rgba(255, 255, 255, 0.97);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  color: #8a948b;
}

.tab-item--active {
  color: #9a6f22;
}

.tab-item--active .tab-icon {
  padding: 7rpx;
  border-radius: 999rpx;
  background: rgba(201, 154, 67, 0.12);
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
}

.tab-text {
  margin-top: 5rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 28rpx;
}

.redeem-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(18, 28, 22, 0.42);
}

.redeem-modal {
  width: 100%;
  padding: 30rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background:
    linear-gradient(180deg, #fbfdf8 0%, #ffffff 100%);
  box-shadow: 0 -16rpx 42rpx rgba(31, 42, 36, 0.12);
}

.redeem-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.redeem-title {
  color: #1f2a24;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.redeem-subtitle {
  margin-top: 8rpx;
  color: #738079;
  font-size: 23rpx;
  line-height: 32rpx;
}

.redeem-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #f1f5ee;
  color: #718077;
  font-size: 40rpx;
  line-height: 58rpx;
}

.redeem-card {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  margin-top: 28rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(47, 107, 67, 0.13);
  border-radius: 22rpx;
  background: #ffffff;
}

.redeem-icon {
  width: 46rpx;
  height: 46rpx;
  margin-right: 16rpx;
  flex: 0 0 auto;
}

.redeem-input {
  min-width: 0;
  height: 90rpx;
  flex: 1;
  color: #1f2a24;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 90rpx;
}

.redeem-placeholder {
  color: #a5aea7;
  font-weight: 500;
  letter-spacing: 0;
}

.redeem-tips {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f4f8f0;
}

.redeem-tip {
  position: relative;
  padding-left: 18rpx;
  color: #6e7a72;
  font-size: 22rpx;
  line-height: 34rpx;
}

.redeem-tip::before {
  position: absolute;
  top: 14rpx;
  left: 0;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #c99a43;
  content: "";
}

.redeem-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #e7eee4;
  color: #879189;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.redeem-submit--ready {
  background: linear-gradient(135deg, #2f6b43 0%, #245c4a 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(36, 92, 74, 0.16);
}

.redeem-submit--loading {
  opacity: 0.72;
}

@media screen and (max-width: 340px) {
  .camp-body {
    width: 74%;
    padding: 22rpx;
  }

  .camp-title {
    font-size: 34rpx;
    line-height: 44rpx;
  }

  .quick-title,
  .list-desc {
    font-size: 20rpx;
  }
}
