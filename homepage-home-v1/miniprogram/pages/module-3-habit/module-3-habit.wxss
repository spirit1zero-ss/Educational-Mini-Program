.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 4%, rgba(214, 168, 74, 0.08), transparent 32%),
    linear-gradient(180deg, #f8faf4 0%, #f6f8f1 52%, #ffffff 100%);
  overflow: hidden;
}

.page-scroll {
  height: calc(100vh - 100px);
}

.content {
  padding: 0 30rpx;
}

.hero {
  padding: 24rpx 8rpx 24rpx;
}

.hero-title {
  color: #10482f;
  font-size: 50rpx;
  line-height: 64rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.quote-card,
.definition-card,
.article-card {
  border: 1rpx solid rgba(15, 90, 61, 0.1);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 22rpx rgba(31, 42, 36, 0.045);
}

.quote-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 118rpx;
  padding: 22rpx 80rpx;
}

.quote-text {
  color: #1d2b26;
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
  text-align: center;
  width: 100%;
}

.quote-mark {
  position: absolute;
  color: #0f5a3d;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 900;
}

.quote-mark--left {
  left: 28rpx;
  top: 24rpx;
}

.quote-mark--right {
  right: 28rpx;
  bottom: 14rpx;
}

.definition-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 24rpx;
}

.definition-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #eef6ef;
  flex: 0 0 auto;
}

.definition-icon {
  width: 54rpx;
  height: 54rpx;
}

.definition-copy {
  color: #3c4a42;
  font-size: 25rpx;
  line-height: 38rpx;
  font-weight: 600;
  flex: 1;
  min-width: 0;
}

.highlight {
  color: #bd8428;
  font-weight: 800;
}

.article-card {
  margin-top: 18rpx;
  padding: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #0f5a3d;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.section-title {
  color: #105035;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 900;
  flex: 1;
  min-width: 0;
}

.paragraph {
  color: #35443b;
  font-size: 24rpx;
  line-height: 40rpx;
  margin-top: 8rpx;
}

.note-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(214, 168, 74, 0.18);
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fffaf0 0%, #f8fbf5 100%);
}

.note-icon {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 auto;
}

.note-text {
  color: #405047;
  font-size: 24rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.final-line {
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(15, 90, 61, 0.1);
  border-radius: 14rpx;
  color: #1f2a24;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
  font-weight: 800;
}

.final-line--cta {
  color: #105035;
  background: #f6faf5;
}

.bottom-spacer {
  height: 170rpx;
}

.assessment-bar {
  position: fixed;
  right: 28rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  min-height: 106rpx;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #0c5438 0%, #0b6a42 100%);
  box-shadow: 0 16rpx 34rpx rgba(15, 90, 61, 0.25);
}

.assessment-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  flex: 0 0 auto;
}

.assessment-copy {
  flex: 1;
  min-width: 0;
}

.assessment-title {
  color: #ffffff;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.assessment-subtitle {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  line-height: 32rpx;
}

.assessment-arrow {
  margin-left: 18rpx;
  color: #ffffff;
  font-size: 54rpx;
  line-height: 1;
  flex: 0 0 auto;
}

@media screen and (max-width: 340px) {
  .hero-title {
    font-size: 42rpx;
    line-height: 56rpx;
  }

  .quote-card {
    padding: 24rpx 56rpx;
  }
}
