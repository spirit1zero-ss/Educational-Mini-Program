@import "../module-3-habit/module-3-habit.wxss";

.camp-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 226rpx;
  padding: 24rpx 4rpx 18rpx;
  overflow: hidden;
}

.camp-hero-copy {
  position: relative;
  z-index: 2;
  max-width: 410rpx;
}

.camp-title {
  color: #10482f;
  font-size: 56rpx;
  line-height: 68rpx;
  font-weight: 900;
}

.camp-hero-image {
  position: absolute;
  right: -2rpx;
  bottom: 16rpx;
  z-index: 1;
  width: 286rpx;
  height: 172rpx;
}

.camp-quote {
  margin-top: 2rpx;
  min-height: 142rpx;
}

.camp-quote .quote-text {
  font-size: 27rpx;
  line-height: 44rpx;
}

.intro-card {
  margin-top: 18rpx;
}

.camp-section-head {
  align-items: center;
  padding-bottom: 6rpx;
  border-bottom: 1rpx dashed rgba(15, 90, 61, 0.22);
}

.camp-section--details .section-title {
  font-size: 24rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.section-subtitle {
  color: #105035;
}

.section-side-icon {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 auto;
}

.goal-list,
.model-list,
.lesson-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.goal-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.goal-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  background: #0f5a3d;
  color: #ffffff;
  font-size: 21rpx;
  line-height: 34rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.goal-text {
  color: #35443b;
  font-size: 24rpx;
  line-height: 40rpx;
  font-weight: 600;
  flex: 1;
  min-width: 0;
}

.model-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 90, 61, 0.08);
  background: linear-gradient(90deg, #f4faf3 0%, #ffffff 100%);
}

.model-icon-wrap,
.system-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid rgba(15, 90, 61, 0.12);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(15, 90, 61, 0.06);
  flex: 0 0 auto;
}

.model-icon,
.system-icon {
  width: 50rpx;
  height: 50rpx;
  opacity: 1;
}

.model-text {
  color: #105035;
  font-size: 27rpx;
  line-height: 38rpx;
  font-weight: 900;
  flex: 1;
  min-width: 0;
}

.system-line {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f6faf5;
  color: #35443b;
  font-size: 24rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.system-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.system-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  padding: 14rpx 8rpx 12rpx;
  border: 1rpx solid rgba(15, 90, 61, 0.08);
  border-radius: 16rpx;
  background: #fbfdf9;
  text-align: center;
}

.system-text {
  color: #405047;
  font-size: 21rpx;
  line-height: 32rpx;
  font-weight: 700;
}

.lesson-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 54rpx;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #f7faf5;
}

.play-mark {
  position: relative;
  width: 34rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: #0f5a3d;
  flex: 0 0 auto;
}

.play-mark::after {
  position: absolute;
  top: 7rpx;
  left: 13rpx;
  width: 0;
  height: 0;
  border-top: 7rpx solid transparent;
  border-bottom: 7rpx solid transparent;
  border-left: 10rpx solid #ffffff;
  content: "";
}

.lesson-text {
  color: #35443b;
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
}

.detail-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-group {
  position: relative;
  display: grid;
  grid-template-columns: 130rpx minmax(0, 1fr);
  column-gap: 18rpx;
  align-items: flex-start;
  min-width: 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(15, 90, 61, 0.08);
  border-radius: 16rpx;
  background: linear-gradient(90deg, #f5faf3 0%, #ffffff 100%);
}

.detail-group::before {
  position: absolute;
  top: 18rpx;
  bottom: 18rpx;
  left: 154rpx;
  width: 1rpx;
  background: rgba(15, 90, 61, 0.1);
  content: "";
}

.detail-title {
  color: #105035;
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.detail-line {
  color: #405047;
  font-size: 23rpx;
  line-height: 36rpx;
  font-weight: 600;
  grid-column: 2;
}

.detail-title + .detail-line {
  margin-top: 0;
}

.detail-group--price .detail-line {
  color: #bd8428;
  font-size: 31rpx;
  line-height: 42rpx;
  font-weight: 900;
  white-space: nowrap;
}

.detail-group--price {
  border-color: rgba(214, 168, 74, 0.2);
  background: linear-gradient(90deg, #fff8e9 0%, #ffffff 100%);
}

.camp-closing {
  margin-top: 18rpx;
  color: #105035;
  background: #f6faf5;
}

.bottom-spacer {
  height: 210rpx;
}

@media screen and (max-width: 340px) {
  .camp-title {
    font-size: 48rpx;
    line-height: 60rpx;
  }

  .camp-hero-image {
    width: 248rpx;
    right: -28rpx;
  }

  .camp-section--details .section-title {
    white-space: normal;
  }

  .system-steps {
    grid-template-columns: 1fr;
  }

  .detail-group {
    grid-template-columns: 1fr;
    row-gap: 8rpx;
  }

  .detail-group::before {
    display: none;
  }

  .detail-line {
    grid-column: 1;
  }

  .detail-group--price .detail-line {
    white-space: normal;
  }
}
