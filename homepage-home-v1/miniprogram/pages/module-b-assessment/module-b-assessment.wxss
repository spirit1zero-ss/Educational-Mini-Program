.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 8%, rgba(216, 166, 64, 0.08), transparent 36%),
    linear-gradient(180deg, #f8faf4 0%, #f3f8f0 54%, #ffffff 100%);
  overflow: hidden;
}

.page-scroll {
  height: calc(100vh - 100px);
}

.content {
  padding: 0 28rpx;
}

.intro {
  padding: 10rpx 4rpx 18rpx;
}

.intro-title {
  color: #10291f;
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.intro-subtitle {
  margin-top: 8rpx;
  color: #496155;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.mind-brief {
  margin-bottom: 20rpx;
}

.tag-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag-pill {
  height: 42rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(201, 154, 67, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.92);
  color: #9a6f22;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.pain-card,
.method-card {
  border: 1rpx solid rgba(31, 107, 87, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(31, 42, 36, 0.045);
}

.pain-card {
  padding: 22rpx;
}

.method-card {
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  background: rgba(242, 247, 239, 0.9);
}

.pain-title,
.method-title {
  color: #10291f;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.pain-text,
.method-text {
  margin-top: 10rpx;
  color: #3f4f46;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.pain-text {
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(47, 107, 67, 0.06);
  color: #2f4439;
  font-weight: 700;
}

.pain-strong {
  margin-top: 14rpx;
  color: #1f6b57;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.question-panel {
  padding: 24rpx 24rpx 20rpx;
  border: 1rpx solid rgba(31, 107, 87, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 34rpx rgba(31, 42, 36, 0.05);
}

.question-copy {
  display: block;
}

.question-title {
  color: #10291f;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 800;
  white-space: nowrap;
}

.question-desc {
  margin-top: 8rpx;
  color: #4f6157;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-align: left;
}

.question-image {
  display: block;
  width: 100%;
  height: 338rpx;
  margin-top: 18rpx;
  border-radius: 22rpx;
  background: #f7f0df;
}

.question-tip {
  margin-top: 14rpx;
  color: #66746b;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
}

.section-heading {
  margin: 32rpx 4rpx 18rpx;
}

.section-title {
  color: #1f2a24;
  font-size: 31rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.section-note {
  margin-top: 6rpx;
  color: #889287;
  font-size: 22rpx;
  line-height: 30rpx;
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.bottom-spacer {
  height: 150rpx;
}

@media screen and (max-width: 340px) {
  .intro-title {
    font-size: 38rpx;
    line-height: 50rpx;
  }

  .pain-text,
  .method-text {
    font-size: 22rpx;
    line-height: 34rpx;
  }

  .question-image {
    height: 292rpx;
  }

  .choice-grid {
    grid-template-columns: 1fr;
  }
}
