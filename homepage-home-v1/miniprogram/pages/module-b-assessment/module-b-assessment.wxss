.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 8%, rgba(216, 166, 64, 0.08), transparent 36%),
    linear-gradient(180deg, #f8faf4 0%, #f3f8f0 54%, #ffffff 100%);
  overflow: hidden;
}

.page-scroll {
  height: calc(100vh - 100px);
}

.content {
  padding: 0 28rpx;
}

.intro {
  padding: 10rpx 4rpx 18rpx;
}

.intro-title {
  color: #183327;
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.intro-subtitle {
  margin-top: 8rpx;
  color: #6d786f;
  font-size: 25rpx;
  line-height: 36rpx;
}

.question-panel {
  padding: 24rpx 24rpx 20rpx;
  border: 1rpx solid rgba(31, 107, 87, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 34rpx rgba(31, 42, 36, 0.05);
}

.question-copy {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.question-title {
  color: #1d2b26;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 800;
  white-space: nowrap;
}

.question-desc {
  color: #758178;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
}

.question-image {
  display: block;
  width: 100%;
  height: 338rpx;
  margin-top: 18rpx;
  border-radius: 22rpx;
  background: #f7f0df;
}

.question-tip {
  margin-top: 14rpx;
  color: #8a948b;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.section-heading {
  margin: 32rpx 4rpx 18rpx;
}

.section-title {
  color: #1f2a24;
  font-size: 31rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.section-note {
  margin-top: 6rpx;
  color: #889287;
  font-size: 22rpx;
  line-height: 30rpx;
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.bottom-spacer {
  height: 150rpx;
}

@media screen and (max-width: 340px) {
  .intro-title {
    font-size: 36rpx;
    line-height: 48rpx;
  }

  .question-copy {
    display: block;
  }

  .question-desc {
    margin-top: 8rpx;
    text-align: left;
  }

  .question-image {
    height: 292rpx;
  }

  .choice-grid {
    grid-template-columns: 1fr;
  }
}
