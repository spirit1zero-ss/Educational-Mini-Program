.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 8%, rgba(216, 166, 64, 0.08), transparent 36%),
    linear-gradient(180deg, #f8faf4 0%, #f3f8f0 54%, #ffffff 100%);
  overflow: hidden;
}

.page-scroll {
  height: calc(100vh - 100px);
}

.content {
  padding: 0 28rpx;
}

.intro {
  padding: 10rpx 4rpx 18rpx;
}

.intro-title {
  color: #183327;
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.intro-subtitle {
  margin-top: 8rpx;
  color: #6d786f;
  font-size: 25rpx;
  line-height: 36rpx;
}

.question-panel {
  border: 1rpx solid rgba(31, 107, 87, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 34rpx rgba(31, 42, 36, 0.05);
}

.question-panel {
  padding: 24rpx 24rpx 20rpx;
}

.question-copy {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.question-title {
  color: #1d2b26;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 800;
  white-space: nowrap;
}

.question-desc {
  color: #758178;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
}

.image-wrap {
  position: relative;
  margin-top: 18rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #f7f0df;
}

.question-image {
  display: block;
  width: 100%;
  height: 356rpx;
}

.image-marker {
  position: absolute;
  top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 3rpx solid rgba(31, 107, 87, 0.18);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  color: #1f6b57;
  font-size: 28rpx;
  line-height: 54rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(31, 42, 36, 0.1);
  transform: translateX(-50%);
}

.image-marker--A {
  left: 22%;
}

.image-marker--B {
  left: 52%;
}

.image-marker--C {
  left: 83%;
}

.question-tip {
  margin-top: 14rpx;
  color: #8a948b;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.bottom-spacer {
  height: 56rpx;
}

@media screen and (max-width: 340px) {
  .intro-title {
    font-size: 36rpx;
    line-height: 48rpx;
  }

  .question-copy {
    display: block;
  }

  .question-desc {
    margin-top: 8rpx;
    text-align: left;
  }

  .question-image {
    height: 312rpx;
  }

  .image-marker {
    width: 48rpx;
    height: 48rpx;
    font-size: 25rpx;
    line-height: 48rpx;
  }

}
