<view class="page">
  <custom-nav title="点击下载表格" showBack="{{true}}" showHome="{{true}}"></custom-nav>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view class="hero">
        <view class="hero-title">点击下载表格</view>
      </view>

      <view class="article-card doc-card" bindtap="onDownloadTable">
        <image class="doc-icon" src="{{iconBase}}assessment-clipboard.png" mode="aspectFit"></image>
        <view class="doc-copy">
          <view class="doc-title">SOP高效作业流程规范表格.docx</view>
          <view class="doc-desc">作业即考试 训练</view>
        </view>
        <view class="doc-action">打开</view>
      </view>

      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <view class="assessment-bar" bindtap="onDownloadTable">
    <image class="assessment-icon" src="{{iconBase}}assessment-clipboard.png" mode="aspectFit"></image>
    <view class="assessment-copy">
      <view class="assessment-title">点击下载表格</view>
      <view class="assessment-subtitle">作业即考试 训练</view>
    </view>
    <view class="assessment-arrow">›</view>
  </view>
</view>
