<view class="page">
  <view class="custom-nav" style="{{navStyle}}">
    <view class="nav-title">线下门店</view>
  </view>

  <scroll-view class="offline-scroll" style="{{scrollStyle}}" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view class="summary-card">
        <view class="summary-head">
          <view>
            <view class="summary-kicker">门店位置</view>
            <view class="summary-title">线下体验点展示</view>
            <view class="summary-desc">这里用于展示线下门店位置。当前先放置前端占位数据，后续可由后台返回门店名称、地址、电话和经纬度。</view>
          </view>
          <image class="summary-icon" src="{{heroIcon}}" mode="aspectFit"></image>
        </view>
      </view>

      <view class="store-panel">
        <view class="section-title">门店列表</view>
        <view
          class="store-card"
          wx:for="{{stores}}"
          wx:key="id"
          bindtap="onStoreTap"
          data-item="{{item}}"
        >
          <view class="store-top">
            <view>
              <view class="store-name">{{item.name}}</view>
              <view class="store-city">{{item.city}}</view>
            </view>
            <view class="store-status">{{item.status}}</view>
          </view>
          <view class="store-address">{{item.address}}</view>
          <view class="store-service">{{item.service}}</view>
          <view class="store-action">查看位置 ›</view>
        </view>
      </view>

      <view class="notice-card">
        <view class="notice-title">后台接入字段</view>
        <view class="notice-line">门店名称、城市、详细地址、联系电话、营业时间、经纬度。</view>
        <view class="notice-line">接入经纬度后，可在本页点击门店直接打开地图导航。</view>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-tab">
    <view
      class="tab-item {{item.key === 'offline' ? 'tab-item--active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bindtap="onTabTap"
      data-item="{{item}}"
    >
      <image class="tab-icon" src="{{item.key === 'offline' ? item.activeIcon : item.icon}}" mode="aspectFit"></image>
      <view class="tab-text">{{item.text}}</view>
    </view>
  </view>
</view>
