<view class="page">
  <view class="custom-nav" style="{{navStyle}}">
    <view class="back-button" bindtap="onBackTap">‹</view>
    <view class="nav-title">推广海报</view>
  </view>

  <scroll-view class="poster-scroll" style="{{scrollStyle}}" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view class="poster-shell">
        <view class="poster-card">
          <image class="poster-bg" src="{{posterBg}}" mode="aspectFill"></image>
          <view class="poster-content">
            <view class="invite-badge">会员专属邀请</view>
            <view class="poster-title">21天自主学习训练营</view>
            <view class="poster-value">让孩子从被催着学，到主动会学</view>
            <view class="poster-subtitle">直播课 + 打卡陪跑 + 答疑服务</view>

            <view class="benefit-panel">
              <view class="benefit-item" wx:for="{{benefits}}" wx:key="title">
                <image class="benefit-icon" src="{{item.icon}}" mode="aspectFit"></image>
                <view class="benefit-copy">
                  <view class="benefit-title">{{item.title}}</view>
                  <view class="benefit-desc">{{item.desc}}</view>
                </view>
              </view>
            </view>

            <view class="price-card">
              <view class="price-main">
                <view class="price-label">特惠报名价</view>
                <view class="price-value">399<text>元</text></view>
              </view>
              <view class="price-divider"></view>
              <view class="price-points">
                <view>科学方法，培养自主学习力</view>
                <view>家长省心，孩子更有成长力</view>
              </view>
            </view>

            <view class="referral-panel">
              <view class="referral-copy">
                <view class="referral-title">推荐人 UID：{{memberUid}}</view>
                <view class="referral-desc">好友报名后，您可获得推广奖励</view>
              </view>
              <view class="code-card" wx:if="{{codeImage}}">
                <image class="code-image" src="{{codeImage}}" mode="aspectFit"></image>
                <view class="code-title">扫码报名</view>
              </view>
              <view class="code-card code-card--empty" wx:else>
                <view class="code-empty-text">报名码生成失败</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="action-bar">
        <view class="save-button {{posterSaving ? 'is-loading' : ''}}" bindtap="onSaveTap">
          {{posterSaving ? '生成中...' : '保存海报'}}
        </view>
        <button class="share-button" open-type="share">分享给好友</button>
      </view>
    </view>
  </scroll-view>

  <view class="poster-canvas-host">
    <canvas
      id="promoPosterCanvas"
      type="2d"
      class="poster-canvas"
    ></canvas>
  </view>
</view>
