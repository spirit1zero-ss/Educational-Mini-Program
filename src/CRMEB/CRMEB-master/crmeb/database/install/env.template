APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = #DB_HOST#
DATABASE = #DB_NAME#
USERNAME = #DB_USER#
PASSWORD = #DB_PWD#
HOSTPORT = #DB_PORT#
CHARSET = #DB_CHARSET#
PREFIX = #DB_PREFIX#
DEBUG = false

[CACHE]
DRIVER = #CACHE_TYPE#
CACHE_PREFIX = #CACHE_PREFIX#
CACHE_TAG_PREFIX = #CACHE_TAG_PREFIX#

[REDIS]
REDIS_HOSTNAME = #RB_HOST#
PORT = #RB_PORT#
REDIS_PASSWORD = #RB_PWD#
SELECT = #RB_SELECT#

[QUEUE]
QUEUE_NAME = #QUEUE_NAME#

[MINIAPP]
APP_ID =
APP_SECRET =
CODE_ENV_VERSION = release
CODE_CHECK_PATH = true

; WeChat Mini Program virtual payment (XPay).
; Production is the safe deployment default. Set ENV=1 explicitly only during sandbox verification.
[XPAY]
ENABLED = false
ENV = 0
OFFER_ID =
SANDBOX_APP_KEY =
PRODUCTION_APP_KEY =
TRAINING_CAMP_PRODUCT_ID =
