APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = #DB_HOST#
DATABASE = #DB_NAME#
USERNAME = #DB_USER#
PASSWORD = #DB_PWD#
HOSTPORT = #DB_PORT#
CHARSET = #DB_CHARSET#
PREFIX = #DB_PREFIX#
