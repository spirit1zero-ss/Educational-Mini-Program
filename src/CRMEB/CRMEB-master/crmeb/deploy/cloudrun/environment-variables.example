PHP_APP_DEBUG=false

PHP_DATABASE_TYPE=mysql
PHP_DATABASE_HOSTNAME=mysql-host
PHP_DATABASE_HOSTPORT=3306
PHP_DATABASE_DATABASE=crmeb
PHP_DATABASE_USERNAME=crmeb
PHP_DATABASE_PASSWORD=replace-with-secret
PHP_DATABASE_CHARSET=utf8
PHP_DATABASE_PREFIX=eb_
PHP_DATABASE_DEBUG=false

PHP_CACHE_DRIVER=redis
PHP_CACHE_CACHE_PREFIX=replace-with-random-prefix:
PHP_CACHE_CACHE_TAG_PREFIX=replace-with-random-tag-prefix:
PHP_REDIS_REDIS_HOSTNAME=redis-host
PHP_REDIS_PORT=6379
PHP_REDIS_REDIS_PASSWORD=replace-with-secret
PHP_REDIS_SELECT=0

PHP_SESSION_TYPE=cache
PHP_SESSION_STORE=redis
PHP_QUEUE_QUEUE_NAME=replace-with-random-queue-name

# WeChat Mini Program credentials. Store APP_SECRET as a secret value.
PHP_MINIAPP_APP_ID=replace-with-mini-program-app-id
PHP_MINIAPP_APP_SECRET=replace-with-mini-program-app-secret
PHP_MINIAPP_CODE_ENV_VERSION=release
PHP_MINIAPP_CODE_CHECK_PATH=true

# WeChat Mini Program virtual payment (XPay). Production deployment example.
# Store AppKeys as secret values. Use XPAY_ENV=1 only in an isolated sandbox service.
PHP_XPAY_ENABLED=false
PHP_XPAY_ENV=0
PHP_XPAY_OFFER_ID=replace-with-offer-id
PHP_XPAY_SANDBOX_APP_KEY=
PHP_XPAY_PRODUCTION_APP_KEY=replace-with-secret
PHP_XPAY_TRAINING_CAMP_PRODUCT_ID=replace-with-membership-entitlement-product-id
